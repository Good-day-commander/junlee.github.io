---
/*
  A publication in a Frame: id and year in the corners, then the one
  anatomy every page uses for a paper: title (linked to the DOI), authors,
  venue, then the DOI and the author-role mark from content.ts on one row.
  No label sits above the title.

  Layout follows the frame's own width (container query), so no frame is
  left half empty:
    narrow  one column: title, authors, venue, DOI and role, note
    wide    (≥ 46rem, a frame alone in the text column) two columns: the
            paper on the left, venue, DOI and note on the right
  Side by side in a grid row, the frame stretches to the row height and the
  text body takes the slack, so a pair ends on one line.

  An optional figure plate sits above the text: a paper figure is never run
  full width; it is centred on a light plate with a hairline, capped near
  560 px, clear of the corner chrome, with an italic caption naming the
  paper. Rank is carried by the parent grid (first-author work gets the
  wider column).
*/
import Frame from '@/components/Frame.astro';
import RoleMark from '@/components/RoleMark.astro';
import type { Publication } from '@/data/content';
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';

export interface Props {
  pub: Publication;
  /** Figure plate shown above the text; width/height set the aspect box. */
  figure?: { src: string; alt: string; width: number; height: number; light?: boolean; caption?: string };
  /** One editorial line (his part, or what the paper does). */
  note?: string;
  /** Kept for callers that mark first-author work; the parent grid sets the width. */
  wide?: boolean;
  class?: string;
}

const { pub, figure, note, wide = false, class: className } = Astro.props;
const doiHref = pub.doi ? `https://doi.org/${pub.doi}` : undefined;

const venueLine = [
  pub.venueShort ?? pub.venue,
  pub.volume,
  pub.article ? pub.article : pub.pages,
]
  .filter(Boolean)
  .join(' · ');

/* Corner label: the year. A manuscript has none; its one status label, "under revision (EAAI)", is the venue line. */
const yearLabel = pub.year || undefined;

/* "Computer Methods and Programs in Biomedicine" → "CMPB", for the plate caption. */
/* Short venue: a trailing "(DMD2026)" when the venue carries one, else venueShort, else the initials (CMPB). */
const venueName = pub.venueShort ?? pub.venue;
const shortVenue =
  /\(([A-Z][^)]*)\)\s*$/.exec(venueName)?.[1] ??
  pub.venueShort ??
  pub.venue.split(/\s+/).filter((w) => /^[A-Z]/.test(w)).map((w) => w[0]).join('');
const showYear = Boolean(pub.year) && !shortVenue.includes(pub.year);
const plateCaption =
  figure?.caption ??
  `Figure from ${pub.id}, ${shortVenue}${pub.volume ? ` ${pub.volume}` : ''}${showYear ? ` (${pub.year})` : ''}.`;
---

<Frame as="article" tl={pub.id} tr={yearLabel} class:list={['paper', { 'paper--wide': wide, 'paper--figure': Boolean(figure) }, className]}>
  {
    figure && (
      <figure class="paper__figure">
        <div class:list={['paper__plate', { 'paper__plate--light': figure.light }]}>
          <img src={figure.src} alt={figure.alt} width={figure.width} height={figure.height} loading="lazy" decoding="async" />
        </div>
        <figcaption class="paper__caption">{plateCaption}</figcaption>
      </figure>
    )
  }
  <div class="paper__text">
    <div class="paper__head">
      <h3 class="paper__title">
        {
          doiHref ? (
            <a href={doiHref} rel="noopener">
              {pub.title}
            </a>
          ) : (
            pub.title
          )
        }
      </h3>
      <p class="paper__authors">{pub.authors}</p>
    </div>
    <div class="paper__meta">
      <p class="paper__venue t-mono">
        {
          pub.year ? (
            <span>{venueLine}</span>
          ) : (
            <span>
              under revision (<abbr title={pub.venue}>{pub.venueShort ?? pub.venue}</abbr>)
            </span>
          )
        }
      </p>
      <div class="paper__row">
        {
          doiHref && (
            <a class="paper__doi t-mono" href={doiHref} rel="noopener">
              <span>doi:{pub.doi}</span>
              <span class="icon" aria-hidden="true" set:html={arrowUpRight} />
            </a>
          )
        }
        <RoleMark role={pub.myRole} />
      </div>
      {note && <p class="paper__note">{note}</p>}
    </div>
  </div>
</Frame>

<style>
  /* The Frame root is a child component; reach it and its body through :global. */
  :global(.frame.paper) {
    display: flex;
    flex-direction: column;
  }
  :global(.frame.paper > .frame__body) {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    container-type: inline-size;
  }

  .paper__figure {
    display: grid;
    justify-items: center;
    gap: var(--space-1);
    margin: 0;
    /* Clear the tl / tr corner chrome before the plate starts. */
    padding: calc(var(--corner-inset, 0.5rem) + 1.5rem) var(--space-3) var(--space-3);
    border-bottom: 1px solid var(--line);
  }
  .paper__plate {
    width: 100%;
    max-width: 35rem;
    padding: var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .paper__plate--light {
    background: var(--box);
  }
  .paper__plate img {
    display: block;
    width: 100%;
    height: auto;
    max-height: min(32rem, 60vh);
    object-fit: contain;
  }
  .paper__plate--light img {
    mix-blend-mode: multiply;
  }
  .paper__caption {
    width: 100%;
    max-width: 35rem;
    font-family: var(--font-text);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .paper__text {
    flex: 1 0 auto;
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: calc(var(--corner-inset, 0.5rem) + 1.5rem) var(--space-3) calc(var(--corner-inset, 0.5rem) + 1rem);
  }
  .paper__figure + .paper__text {
    padding-top: var(--space-3);
  }
  .paper__head,
  .paper__meta {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    min-width: 0;
  }
  .paper__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  /* A frame alone in the text column runs as two columns instead of leaving its right half empty. */
  @container (min-width: 46rem) {
    .paper__text {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      column-gap: var(--space-5);
    }
    .paper__meta {
      padding-top: 0.3rem;
    }
  }
  .paper__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--size-subheading);
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
    max-width: 36ch;
  }
  .paper__title a {
    color: inherit;
    text-decoration-color: var(--line);
  }
  .paper__title a:hover {
    text-decoration-color: var(--signal);
  }
  .paper__authors {
    font-family: var(--font-text);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: var(--measure);
  }
  .paper__venue {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    color: var(--ink-2);
  }
  .paper__venue abbr {
    text-decoration: none;
    cursor: help;
  }
  .paper__doi {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    justify-self: start;
    color: var(--ink);
    text-decoration-color: var(--ink-3);
    overflow-wrap: anywhere;
  }
  .paper__doi .icon :global(svg) {
    width: 0.9em;
    height: 0.9em;
    fill: currentColor;
  }
  .paper__note {
    font-family: var(--font-text);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: var(--measure);
    margin-top: 0.4rem;
    text-wrap: pretty;
  }
</style>
