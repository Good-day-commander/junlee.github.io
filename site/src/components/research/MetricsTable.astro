---
/*
  The one metrics table the research chapters share: an italic STIX
  caption above (the label convention, e.g. "current model, 85 cases,
  10-fold CV", or the manuscript status), a ruled mono table, nothing
  else. Rows are computed in lib/schema.ts from the manifests; nothing
  is typed here.
*/
export interface Props {
  id: string;
  caption: string;
  head: string[];
  rows: string[][];
  label: string;
}

const { id, caption, head, rows, label } = Astro.props;

/*
  A value that pairs two readings ("CFD 0.830 · PINO 0.824") is split at its
  middle dot into unbreakable segments, so on a phone it may break between
  the readings but never inside one.
*/
const segments = (v: string) => v.split(' · ');
---

<figure class="metrics">
  <figcaption class="metrics__caption" id={`${id}-caption`}>{caption}</figcaption>
  <div class="metrics__scroll" tabindex="0" role="region" aria-label={label}>
    <table class="t-mono" aria-describedby={`${id}-caption`}>
      <thead>
        <tr>{head.map((h) => <th scope="col">{h}</th>)}</tr>
      </thead>
      <tbody>
        {
          rows.map(([first, ...rest]) => (
            <tr>
              <th scope="row">{first}</th>
              {rest.map((v) => (
                <td>
                  {segments(v).map((seg, i, all) => (
                    <>
                      <span class="metrics__seg">{i < all.length - 1 ? `${seg} ·` : seg}</span>
                      {i < all.length - 1 && ' '}
                    </>
                  ))}
                </td>
              ))}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</figure>

<style>
  .metrics {
    display: grid;
    gap: var(--space-1);
    margin: 0;
    width: 100%;
  }
  .metrics__caption {
    font-family: var(--font-text);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  /*
    The scroll region is a guard only: under 600px the metric labels and the
    column heads wrap (about 18ch) and the value cells keep their readings
    whole, so every value column fits a 390 px phone without scrolling.
  */
  .metrics__scroll {
    overflow-x: auto;
    overscroll-behavior-x: contain;
  }
  .metrics__scroll:focus-visible {
    outline: var(--ring);
    outline-offset: var(--ring-offset);
  }
  table {
    width: 100%;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  th,
  td {
    text-align: left;
    padding: 0.45rem var(--space-3) 0.45rem 0;
    vertical-align: top;
    font-weight: 400;
    white-space: nowrap;
  }
  th:last-child,
  td:last-child {
    padding-right: 0;
  }
  thead th {
    color: var(--ink-3);
    border-bottom: 1px solid var(--line);
  }
  tbody tr + tr th,
  tbody tr + tr td {
    border-top: 1px solid var(--line-soft);
  }
  tbody th {
    color: var(--ink-2);
  }
  td {
    color: var(--ink);
  }
  .metrics__seg {
    white-space: nowrap;
  }

  @media (max-width: 599.98px) {
    th,
    td {
      padding-right: var(--space-2);
    }
    thead th,
    tbody th {
      white-space: normal;
      max-width: 18ch;
      text-wrap: pretty;
    }
    td {
      white-space: normal;
    }
  }
</style>
