---
/*
  The A⁺4DCT results plate on /research (project "a4dct"). One film plate:
  the cases on one chart, a row per calcium score with the 4DCT and A⁺4DCT
  mean Pd/Pa and the invasive FFR they are checked against, beside the
  selected case's vessel video and its readout. Under the plate, the caption
  with the status sentence exactly as content.ts holds it. Every number
  comes from content.ts (a4dctResults) and is formatted with lib/format.ts:
  FFR reads two decimals on the chart and in the readout, three in the
  table that stands in for the chart without JavaScript.

  The case control is a native <select> with a Phosphor caret. It ships
  hidden and the script shows it (without JavaScript it could not switch
  anything, as with the fluid-bolus Replay); a change shows that case's
  video and readout and marks its chart row. The videos are muted, inline
  and looped, never autoplay (so reduced motion has nothing to stop) and
  preload nothing, so no video byte moves until a reader presses play. A
  video that fails prints the approved sentence in its place and logs the
  reason to the console.
*/
import Frame from '@/components/Frame.astro';
import MetricsTable from '@/components/research/MetricsTable.astro';
import type { CoronaryResults } from '@/data/content';
import { formatDecimal, formatInt, numberWord } from '@/lib/format';
import { calciumScore } from '@/lib/schema';
import caretDown from '@phosphor-icons/core/assets/regular/caret-down.svg?raw';

interface Props { results: CoronaryResults }
const { results } = Astro.props;
const selected = results.cases.length - 1;
const min = Math.floor(Math.min(...results.cases.map((c) => c.beforeFfr)) * 10) / 10;
const max = Math.ceil(Math.max(...results.cases.flatMap((c) => [c.afterFfr, c.clinicalFfr])) * 10) / 10;
const ticks = Array.from({ length: Math.round((max - min) * 10) + 1 }, (_, i) => min + i / 10);
const x = (value: number) => 88 + (value - min) / (max - min) * 366;
const y = (index: number) => 58 + index * 46;
const legend = ['4DCT', 'A⁺4DCT', 'Invasive FFR'];
const phases = `${formatInt(results.phaseCount)}-phase mean Pd/Pa`;
---

<figure class="study" data-coronary-study>
  <Frame plate>
    <div class="study__body">
      <div class="study__head">
        <p class="study__title">With and without angio enhancement</p>
        <label class="study__select" hidden>
          Calcium score
          <span class="study__control">
            <select>
              {results.cases.map((c, index) => <option value={index} selected={index === selected}>{calciumScore(c.calcium)}</option>)}
            </select>
            <span class="study__caret" aria-hidden="true" set:html={caretDown} />
          </span>
        </label>
      </div>
      <div class="study__legend">
        {legend.map((label, index) => (
          <span>
            <svg viewBox="0 0 20 20" aria-hidden="true">
              {index === 2 ? <path d="M10 2 L18 10 L10 18 L2 10 Z" class="clinical" /> : <circle cx="10" cy="10" r="6" class={index === 0 ? 'before' : 'after'} />}
            </svg>
            {label}
          </span>
        ))}
      </div>
      <div class="study__comparison">
        <div class="study__chart">
          <svg viewBox="0 0 480 310" role="img" aria-labelledby="a4dct-chart-title a4dct-chart-desc">
            <title id="a4dct-chart-title">Angio enhancement and the invasive reference</title>
            <desc id="a4dct-chart-desc">{results.cases.map((c) => `Calcium score ${calciumScore(c.calcium)}: 4DCT ${formatDecimal(c.beforeFfr)}, A⁺4DCT ${formatDecimal(c.afterFfr)}, invasive FFR ${formatDecimal(c.clinicalFfr)}.`).join(' ')}</desc>
            <text x="2" y="19" class="axis-label">Calcium score</text>
            {ticks.map((tick) => (
              <g>
                <line x1={x(tick)} x2={x(tick)} y1="35" y2="266" class="grid" />
                <text x={x(tick)} y="288" text-anchor="middle" class="tick">{formatDecimal(tick, 1)}</text>
              </g>
            ))}
            {results.cases.map((c, index) => (
              <g data-study-row={index} data-selected={index === selected ? 'true' : 'false'}>
                <rect x="0" y={y(index) - 20} width="480" height="40" class="row-focus" />
                <text x="2" y={y(index) + 6} class="tick">{calciumScore(c.calcium)}</text>
                <line x1={x(c.beforeFfr)} x2={x(c.afterFfr)} y1={y(index)} y2={y(index)} class="change" />
                <circle cx={x(c.beforeFfr)} cy={y(index)} r="5" class="before"><title>4DCT: {formatDecimal(c.beforeFfr)}</title></circle>
                <circle cx={x(c.afterFfr)} cy={y(index)} r="5" class="after"><title>A⁺4DCT: {formatDecimal(c.afterFfr)}</title></circle>
                <path d={`M${x(c.clinicalFfr)} ${y(index) - 8} l8 8 -8 8 -8 -8 Z`} class="clinical"><title>Invasive FFR: {formatDecimal(c.clinicalFfr)}</title></path>
              </g>
            ))}
          </svg>
          <p class="study__axis">{phases}; invasive FFR as reference</p>
        </div>
        <div class="study__cases">
          {results.cases.map((c, index) => (
            <div class="study__case" data-study-case={index} hidden={index !== selected}>
              <div class="study__stage">
                <video controls playsinline muted loop preload="none"
                  poster={c.poster} aria-label={`Coronary pressure-ratio cycle, calcium score ${calciumScore(c.calcium)}`}>
                  <source src={c.video} type="video/mp4" />
                  <a href={c.video}>View the coronary pressure-ratio cycle</a>
                </video>
                <p class="study__error" role="status" hidden>The vessel did not load. Reload the page to try again.</p>
              </div>
              <p class="study__video-note">Instantaneous Pd(t)/Pa(t)</p>
              <table class="study__values">
                <caption class="sr-only">Comparison for calcium score {calciumScore(c.calcium)}</caption>
                <thead><tr>{legend.map((label) => <th scope="col">{label}</th>)}</tr></thead>
                <tbody><tr><td>{formatDecimal(c.beforeFfr)}</td><td class="study__enhanced">{formatDecimal(c.afterFfr)}</td><td>{formatDecimal(c.clinicalFfr)}</td></tr></tbody>
              </table>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Frame>
  <figcaption class="study__caption">The {numberWord(results.cases.length)} cases are ordered by calcium score. {results.status}</figcaption>
  <noscript>
    <MetricsTable
      id="a4dct-values"
      label="A⁺4DCT comparison, case by case"
      caption={`${phases} without and with angio enhancement; invasive FFR is the reference.`}
      head={['Calcium score', ...legend]}
      rows={results.cases.map((c) => [calciumScore(c.calcium), formatDecimal(c.beforeFfr, 3), formatDecimal(c.afterFfr, 3), formatDecimal(c.clinicalFfr, 3)])}
    />
  </noscript>
</figure>

<script>
  for (const study of document.querySelectorAll<HTMLElement>('[data-coronary-study]')) {
    const select = study.querySelector<HTMLSelectElement>('select');
    const label = study.querySelector<HTMLElement>('.study__select');
    const panels = study.querySelectorAll<HTMLElement>('[data-study-case]');
    if (!select || !label) continue;
    label.hidden = false;
    select.addEventListener('change', () => {
      for (const panel of panels) {
        const shown = panel.dataset.studyCase === select.value;
        if (!shown) panel.querySelector('video')?.pause();
        panel.hidden = !shown;
      }
      for (const row of study.querySelectorAll<SVGGElement>('[data-study-row]')) {
        row.dataset.selected = String(row.dataset.studyRow === select.value);
      }
    });
    for (const panel of panels) {
      const video = panel.querySelector('video');
      const error = panel.querySelector<HTMLElement>('.study__error');
      const onError = () => {
        if (panel.hasAttribute('data-failed')) return;
        panel.setAttribute('data-failed', '');
        if (video) video.hidden = true;
        if (error) error.hidden = false;
        console.error('A4dctResults: a vessel video did not load.', video?.currentSrc || video?.querySelector('source')?.src);
      };
      video?.addEventListener('error', onError);
      video?.querySelector('source')?.addEventListener('error', onError);
    }
  }
</script>

<style>
  .study { margin: 0; display: grid; gap: var(--space-1); }
  .study__body { padding: var(--space-2); }
  .study__head { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: var(--space-2); }
  .study__title { font-family: var(--font-ui); font-size: var(--size-ui); color: var(--ink); }
  .study__select { display: flex; align-items: center; gap: var(--space-1); font-family: var(--font-ui); font-size: var(--size-ui); color: var(--ink-2); }
  /* The case control: the native list, drawn flat with the site's caret (Phosphor caret-down) in place of the browser's arrow. */
  .study__control { position: relative; display: inline-grid; align-items: center; }
  select {
    appearance: none;
    min-height: 2.5rem;
    padding: 0.25rem 2.25rem 0.25rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--size-mono);
    cursor: pointer;
    transition: border-color var(--duration-quick) var(--ease-out);
  }
  select:hover { border-color: var(--ink-3); }
  select:focus-visible { outline: var(--ring); outline-offset: var(--ring-offset); }
  .study__caret {
    position: absolute;
    right: 0.75rem;
    width: 1rem;
    height: 1rem;
    color: var(--ink-2);
    pointer-events: none;
  }
  .study__caret :global(svg) { display: block; width: 100%; height: 100%; fill: currentColor; }
  .study__legend { display: flex; flex-wrap: wrap; gap: var(--space-1) var(--space-2); margin-block: var(--space-2); font-family: var(--font-ui); font-size: var(--size-mono); color: var(--ink-2); }
  .study__legend span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .study__legend svg { width: 1rem; height: 1rem; }
  .study__comparison { display: grid; grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: var(--space-2); align-items: start; }
  .study__chart > svg { display: block; width: 100%; height: auto; overflow: visible; }
  .grid { stroke: var(--line-soft); stroke-width: 1; }
  .tick { fill: var(--ink-2); font-family: var(--font-mono); font-size: 20px; }
  .axis-label { fill: var(--ink-2); font-family: var(--font-ui); font-size: 20px; }
  .row-focus { fill: transparent; }
  [data-selected='true'] .row-focus { fill: var(--bg-2); }
  .change { stroke: var(--ink-2); stroke-width: 2; }
  .before { fill: var(--bg); stroke: var(--ink); stroke-width: 2; }
  .after { fill: var(--signal); stroke: var(--signal); stroke-width: 2; }
  .clinical { fill: var(--bg); stroke: var(--ink); stroke-width: 2; }
  .study__axis, .study__video-note { font-family: var(--font-ui); font-size: var(--size-mono); line-height: 1.5; color: var(--ink-2); }
  .study__axis { margin-top: var(--space-1); }
  .study__stage { position: relative; min-height: 16rem; }
  video { display: block; width: 100%; height: 16rem; object-fit: contain; background: var(--bg); }
  .study__video-note { margin-block: var(--space-1); }
  .study__values { width: 100%; border-collapse: collapse; border-top: 1px solid var(--line); }
  .study__values th { font-family: var(--font-ui); font-weight: 400; font-size: var(--size-mono); color: var(--ink-2); }
  .study__values td { font-family: var(--font-mono); font-size: var(--size-ui); color: var(--ink); }
  .study__values th, .study__values td { padding: 0.4rem 0.1rem; text-align: center; }
  .study__values .study__enhanced { color: var(--signal); }
  .study__caption { font-family: var(--font-text); font-style: italic; font-size: var(--size-caption); line-height: 1.5; color: var(--ink-2); }
  /* A failed video: one STIX sentence centred where the video was (as on the other plates); the note under it goes with the video. */
  .study__error {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    margin: 0;
    padding: var(--space-2);
    font-family: var(--font-text);
    font-size: var(--size-caption);
    line-height: 1.5;
    color: var(--ink-2);
    text-align: center;
    text-wrap: pretty;
  }
  .study__case[data-failed] .study__video-note { visibility: hidden; }
  [hidden] { display: none; }
  @media (prefers-reduced-motion: reduce) {
    select { transition: none; }
  }
  @media (max-width: 640px) {
    .study__body { padding: var(--space-1); }
    .study__comparison { grid-template-columns: minmax(0, 1fr); }
    .study__stage { min-height: 20rem; }
    video { height: 20rem; }
    .study__values { margin-top: var(--space-1); }
  }
</style>
