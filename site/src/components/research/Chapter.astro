---
/*
  One research chapter (contract revision 2): a header row (the chapter
  name and one claim carrying its number), the artifact at frame width,
  then the reading column: one paragraph, the metrics table and the
  citation line. No consequence line and no per-chapter mail link; the
  nav and the footer carry the contact routes.

    <Chapter id="flow" heading="Flow" claim="…">
      <Fragment slot="artifact">…plates…</Fragment>
      …paragraph, MetricsTable, Cite…
    </Chapter>
*/
export interface Props {
  id: string;
  heading: string;
  claim: string;
  /** Optional mono line under the claim (Flow: CFD time against PINO time). */
  meta?: string;
}

const { id, heading, claim, meta } = Astro.props;
---

<section class="chapter" id={id} aria-labelledby={`${id}-heading`}>
  <header class="chapter__head wrap">
    <h2 id={`${id}-heading`} class="chapter__name">{heading}</h2>
    <div class="chapter__lead">
      <p class="chapter__claim">{claim}</p>
      {meta && <p class="chapter__meta t-mono">{meta}</p>}
    </div>
  </header>

  <div class="chapter__artifact wrap">
    <slot name="artifact" />
  </div>

  <div class="chapter__read wrap">
    <slot />
  </div>
</section>

<style>
  .chapter {
    padding-top: var(--space-6);
  }
  .chapter__head {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: var(--space-1) var(--space-3);
    align-items: baseline;
    margin-bottom: var(--space-3);
  }
  .chapter__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--size-heading);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
  }
  .chapter__claim {
    font-family: var(--font-text);
    font-size: 1.1875rem;
    line-height: 1.45;
    color: var(--ink);
    text-wrap: pretty;
  }
  .chapter__lead {
    display: grid;
    gap: 0.3rem;
  }
  .chapter__meta {
    color: var(--ink-2);
  }
  .chapter__artifact {
    margin-bottom: var(--space-4);
  }
  .chapter__read {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  @media (max-width: 640px) {
    .chapter {
      padding-top: var(--space-5);
    }
    .chapter__head {
      grid-template-columns: minmax(0, 1fr);
    }
    .chapter__claim {
      font-size: 1.0625rem;
    }
  }
</style>
