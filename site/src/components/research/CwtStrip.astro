---
/*
  The CWT companion to the STFT artifact in the Pulse chapter: the same
  60 s signal through a Morlet wavelet, framed with its method in the
  corners. Numbers come from the pulse manifest.
*/
import Frame from '@/components/Frame.astro';
import SpectrogramDevelop from '@/islands/SpectrogramDevelop';
import { formatDecimal, formatInt } from '@/lib/format';
import { pulse, urls } from './data';

const m = pulse.cwt.method;
const fRange = `${formatDecimal(m.f_range_hz[0], 1)}–${formatDecimal(m.f_range_hz[1], 1)} Hz`;
const wavelet = m.wavelet === 'morl' ? 'Morlet' : m.wavelet;
const durationS = Math.round(pulse.cwt.t_s[pulse.cwt.t_s.length - 1]);
/* The Frame carries the border and the name; the island, mounted bare, draws the clock, colorbar and method line. */
---

<Frame as="figure" tl="PPG · CWT">
  <SpectrogramDevelop client:visible manifestUrl={urls.pulseManifest} variant="cwt" bare />
  <Fragment slot="what">Continuous wavelet transform</Fragment>
  <Fragment slot="result">
    {wavelet} · {formatInt(m.n_scales)} scales · {fRange} · {formatInt(pulse.cwt.rows)} × {formatInt(pulse.cwt.cols)} ·
    same {durationS} s recording
  </Fragment>
  <Fragment slot="consequence">The second representation the ensemble reads; two of its six configurations see this.</Fragment>
</Frame>
