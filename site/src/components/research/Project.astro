---
/*
  One research project on /research: a header row (the title, the years on
  the right), the one-sentence summary and the outputs line, each output a
  link to its row on the CV. A demo project passes its plates, method and
  citation in the default slot and keeps its old chapter anchor (an empty
  span, so /research/#flow still lands here). Everything spans the column.
*/
import type { ResearchEntry } from '@/lib/schema';

export interface Props {
  entry: ResearchEntry;
  /** The old chapter id this project answers to ("flow", "image", "pulse"). */
  anchor?: string;
}

const { entry, anchor } = Astro.props;
const headingId = `${entry.id}-title`;
---

<article class="project wrap" id={entry.id} aria-labelledby={headingId}>
  {anchor && <span id={anchor} class="project__anchor" />}
  <header class="project__head">
    <h2 id={headingId} class="project__title">{entry.title}</h2>
    <p class="project__years t-mono">{entry.years}</p>
  </header>
  <p class="project__summary">{entry.summary}</p>
  {
    entry.outputs.length > 0 && (
      <p class="project__outputs t-mono">
        {/* One line of markup: no whitespace between an item and its dot, so a wrap falls after the dot. */}
        {entry.outputs.map((o, i) => <>{i > 0 && <span class="project__sep">{'\u00a0· '}</span>}<a href={o.href}>{o.text}</a></>)}
      </p>
    )
  }
  {Astro.slots.has('default') && (
    <div class="project__demo">
      <slot />
    </div>
  )}
</article>

<style>
  .project {
    display: grid;
    gap: var(--space-2);
    padding-top: var(--space-6);
  }
  .project__anchor {
    display: block;
    height: 0;
  }
  .project__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-1) var(--space-3);
    align-items: baseline;
  }
  .project__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--size-heading);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-heading);
    text-wrap: balance;
  }
  .project__years {
    color: var(--ink-2);
    white-space: nowrap;
  }
  .project__summary {
    font-family: var(--font-text);
    font-size: 1.1875rem;
    line-height: 1.45;
    color: var(--ink);
    text-wrap: pretty;
  }
  .project__outputs {
    color: var(--ink-2);
  }
  .project__outputs a {
    color: inherit;
    text-decoration-color: var(--line);
    white-space: nowrap;
  }
  .project__outputs a:hover {
    color: var(--ink);
    text-decoration-color: var(--signal);
  }
  /* The dot keeps to the item before it (a no-break space), so a wrapped line never starts with one. */
  .project__sep {
    color: var(--ink-3);
  }
  .project__demo {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }
  @media (max-width: 640px) {
    .project {
      padding-top: var(--space-5);
    }
    .project__head {
      grid-template-columns: minmax(0, 1fr);
    }
    .project__summary {
      font-size: 1.0625rem;
    }
  }
</style>
