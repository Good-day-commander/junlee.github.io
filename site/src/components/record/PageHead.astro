---
/*
  Page header for the Read surfaces: h1, one lede computed from the data,
  and (optionally) a row of in-page anchors. No kicker, no number.
*/
export interface Props {
  heading: string;
  lede?: string;
  anchors?: { href: string; label: string }[];
}
const { heading, lede, anchors } = Astro.props;
---

<header class="page-head">
  <div class="wrap wrap--text">
    <h1 class="page-head__title">{heading}</h1>
    {lede && <p class="page-head__lede t-prose">{lede}</p>}
    <slot />
    {
      anchors && anchors.length > 0 && (
        <nav class="page-head__anchors" aria-label="On this page">
          <ul>
            {anchors.map((a) => (
              <li>
                <a href={a.href}>{a.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</header>

<style>
  .page-head {
    padding-block: var(--section-pad) var(--space-5);
    border-bottom: 1px solid var(--line);
  }
  .page-head__title {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 92;
    font-weight: 600;
    font-size: clamp(2.25rem, 1.6rem + 3vw, 4rem);
    line-height: 1;
    letter-spacing: -0.025em;
    max-width: 20ch;
  }
  .page-head__lede {
    margin-top: var(--space-3);
    color: var(--ink-2);
  }
  .page-head__anchors {
    margin-top: var(--space-4);
  }
  .page-head__anchors ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
  }
  .page-head__anchors a {
    display: inline-block;
    padding-block: 0.35rem;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--size-ui);
    color: var(--ink-2);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition:
      color var(--duration-quick) var(--ease-out),
      border-color var(--duration-quick) var(--ease-out);
  }
  .page-head__anchors a:hover {
    color: var(--ink);
    border-bottom-color: var(--signal);
  }
</style>
