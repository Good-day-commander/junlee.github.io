---
/*
  One CV section: a ruled heading in the PDF's order and a dense body. In
  print the sections run on and a heading never ends a page. Tighter than
  Section.astro on purpose: the CV is a document, not a landing surface.

  empty: the section's list is empty; it renders nothing (cv.astro drops
  its jump-row link too).

  fold: the heading row and the body sit in a <details> that ships open. On
  phones the heading row is the summary, with a caret, and the inline script
  in cv.astro closes it on load; above phone width the summary is inert and the
  caret hidden, so the heading and its rule look exactly as without fold.
*/
import caretDown from '@phosphor-icons/core/assets/regular/caret-down.svg?raw';

export interface Props {
  heading: string;
  id: string;
  /** Fold the section to its heading row on phones. */
  fold?: boolean;
  /** Nothing to list: render nothing. */
  empty?: boolean;
}
const { heading, id, fold = false, empty = false } = Astro.props;
---

{!empty && (
<section class="cv-section" id={id} aria-labelledby={`${id}-heading`}>
  {
    fold ? (
      <details class="cv-fold" open>
        <summary class="cv-fold__summary">
          <h2 id={`${id}-heading`} class="cv-section__heading">{heading}</h2>
          <span class="cv-fold__caret" aria-hidden="true" set:html={caretDown} />
        </summary>
        <div class="cv-section__body">
          <slot />
        </div>
      </details>
    ) : (
      <>
        <h2 id={`${id}-heading`} class="cv-section__heading">{heading}</h2>
        <div class="cv-section__body">
          <slot />
        </div>
      </>
    )
  }
</section>
)}

<style>
  /* Dense report surface: a 24px gap between sections (contract revision 2: at most 40px). */
  .cv-section {
    padding-top: var(--space-3);
    scroll-margin-top: var(--space-1);
  }
  .cv-section__heading {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
    padding-bottom: 0.4rem;
    margin-bottom: var(--space-1);
    border-bottom: 1px solid var(--ink);
  }
  .cv-section__body {
    display: grid;
    gap: var(--space-1);
  }
  .cv-fold__summary {
    display: block;
    position: relative;
    list-style: none;
  }
  .cv-fold__summary::-webkit-details-marker {
    display: none;
  }
  .cv-fold__caret {
    display: none;
  }
  @media not (max-width: 640px) {
    .cv-fold__summary {
      pointer-events: none;
    }
  }
  /* Phones: the heading row opens and closes its section; the caret points down while closed, up while open. */
  @media (max-width: 640px) {
    .cv-section:has(> .cv-fold:not([open])) {
      padding-top: var(--space-2);
    }
    .cv-fold__summary {
      cursor: pointer;
    }
    .cv-fold__summary > .cv-section__heading {
      padding-right: 2rem;
    }
    .cv-fold__caret {
      position: absolute;
      top: 0;
      right: 0;
      display: flex;
      align-items: center;
      width: 1rem;
      height: 1.6875rem; /* the heading's first line: 1.25rem at line height 1.35 */
      color: var(--ink-2);
      transition: transform var(--duration-quick) var(--ease-out);
    }
    .cv-fold__caret :global(svg) {
      width: 1rem;
      height: 1rem;
      fill: currentColor;
    }
    .cv-fold[open] .cv-fold__caret {
      transform: rotate(180deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cv-fold__caret {
      transition: none;
    }
  }
  @media print {
    .cv-fold__caret {
      display: none;
    }
    .cv-section {
      padding-top: 1.25rem;
    }
    .cv-section__heading {
      break-after: avoid;
      font-size: 12.5pt;
    }
    .cv-section__body {
      gap: 0.6rem;
    }
  }
</style>
