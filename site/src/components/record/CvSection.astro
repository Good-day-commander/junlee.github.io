---
/*
  One CV section: a ruled heading in the PDF's order, dense body, and a page
  break before it in print. Tighter than Section.astro on purpose: the CV is
  a document, not a landing surface.
*/
export interface Props {
  heading: string;
  id: string;
  /** Keep this section on the same printed page as the one before it. */
  flow?: boolean;
}
const { heading, id, flow = false } = Astro.props;
---

<section class:list={['cv-section', { 'cv-section--flow': flow }]} id={id} aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`} class="cv-section__heading">{heading}</h2>
  <div class="cv-section__body">
    <slot />
  </div>
</section>

<style>
  .cv-section {
    padding-top: var(--space-5);
  }
  .cv-section__heading {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    padding-bottom: var(--space-1);
    margin-bottom: var(--space-3);
    border-bottom: 1px solid var(--ink);
  }
  .cv-section__body {
    display: grid;
    gap: var(--space-3);
  }
  @media print {
    .cv-section {
      padding-top: 1.25rem;
      break-before: page;
    }
    .cv-section--flow {
      break-before: auto;
    }
    .cv-section__heading {
      break-after: avoid;
      font-size: 12.5pt;
    }
    .cv-section__body {
      gap: 0.6rem;
    }
  }
</style>
