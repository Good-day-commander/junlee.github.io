---
/*
  One publication as a dense CV row (the /publications page is retired;
  this is its record on /cv#publications). Three short lines: the title
  (linked to the DOI), the author list exactly as the CV prints it, then
  one mono line with the citation, the author-role mark, the doi, an
  optional figure link and the BibTeX control. Every string comes from
  content.ts; the BibTeX is generated from the same record at build time.

  BibTeX is one disclosure: its panel holds the entry (readable and
  selectable without JavaScript) and a Copy action that confirms inline
  for two seconds. No per-entry mail link: the nav and footer carry email.
*/
import type { Publication } from '@/data/content';
import RoleMark from '@/components/RoleMark.astro';
import Button from '@/components/Button.astro';
import Authors from './Authors.astro';
import { bibtex } from './bibtex';
import { citationLine, doiUrl, PLATES } from './records';

export interface Props {
  pub: Publication;
}
const { pub } = Astro.props;
const doi = doiUrl(pub);
const bib = bibtex(pub);
const plate = PLATES[pub.id];
/* The short venue (C1/C2 drop the conference location) keeps the mono line to one line; the full venue is in the BibTeX, cv.md and cv.json. */
const cite = pub.type === 'under-review' ? `${pub.venue} · ${pub.status}` : citationLine(pub, { shortVenue: true });
/* Phones: the venue as its code ("CMPB") so the citation line stays short; the full line is shown from 600px up. */
const venueCode = pub.venueShort ?? pub.venue.split(/\s+/).filter((w) => /^[A-Z]/.test(w)).map((w) => w[0]).join('');
const citeShort = cite.replace(pub.venue, venueCode);
---

<li class="pub" id={pub.id}>
  <span class="pub__id t-mono" aria-hidden="true">{pub.id}</span>
  <div class="pub__main">
    <p class="pub__title">{doi ? <a href={doi} rel="noopener">{pub.title}</a> : pub.title}</p>
    <Authors authors={pub.authors} class="pub__authors" />
    <div class="pub__meta t-mono">
      <span class="pub__cite pub__cite--full">{cite}</span>
      <span class="pub__cite pub__cite--short" aria-hidden="true">{citeShort}</span>
      <RoleMark role={pub.myRole} class="pub__role" />
      {
        doi && (
          <a class="pub__doi" href={doi} rel="noopener" aria-label={`doi:${pub.doi}`}>
            <span class="pub__doi-full">doi:{pub.doi}</span>
            <span class="pub__doi-short" aria-hidden="true">DOI</span>
          </a>
        )
      }
      {
        plate && (
          <a class="pub__fig" href={plate.src} title={plate.alt}>
            figure
          </a>
        )
      }
      <details class="pub__details" id={`bib-${pub.id}`}>
        <summary>BibTeX</summary>
        <div class="pub__panel">
          <div class="pub__bib" aria-live="polite">
            <Button variant="ghost" size="compact" class="pub__copy" type="button" aria-controls={`bib-${pub.id}`}>
              Copy BibTeX
            </Button>
          </div>
          <pre tabindex="0">{bib}</pre>
        </div>
      </details>
    </div>
  </div>
</li>

<style>
  .pub {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0 var(--space-2);
    padding-block: 0.2rem 0.25rem;
    border-bottom: 1px solid var(--line-soft);
  }
  .pub__id {
    color: var(--ink-3);
    padding-top: 0.15rem;
  }
  .pub__main {
    display: grid;
    gap: 0;
    min-width: 0;
  }
  .pub__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.975rem;
    line-height: 1.35;
    text-wrap: pretty;
  }
  .pub__title a {
    color: inherit;
    text-decoration-color: var(--line);
  }
  .pub__title a:hover {
    text-decoration-color: var(--signal);
  }
  .pub :global(.pub__authors) {
    font-size: 0.875rem;
    line-height: 1.35;
  }
  .pub__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.15rem var(--space-2);
    color: var(--ink-2);
    line-height: 1.35;
  }
  .pub__meta :global(.pub__role) {
    min-height: 1.0625rem;
  }
  .pub__doi,
  .pub__fig {
    color: var(--ink);
    text-decoration-color: var(--line);
    overflow-wrap: anywhere;
  }
  .pub__doi:hover,
  .pub__fig:hover {
    text-decoration-color: var(--signal);
  }
  .pub__cite--short,
  .pub__doi-short {
    display: none;
  }
  @media (max-width: 599.98px) {
    .pub__cite--full,
    .pub__doi-full {
      display: none;
    }
    .pub__cite--short,
    .pub__doi-short {
      display: inline;
    }
  }
  .pub__details summary {
    display: inline-block;
    cursor: pointer;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.18em;
    list-style: none;
    transition: text-decoration-color var(--duration-quick) var(--ease-out);
  }
  .pub__details summary::-webkit-details-marker {
    display: none;
  }
  .pub__details summary:hover {
    text-decoration-color: var(--signal);
  }
  .pub__details[open] {
    flex-basis: 100%;
  }
  .pub__panel {
    display: grid;
    justify-items: start;
    gap: var(--space-1);
    margin-block: var(--space-1);
  }
  .pub__bib[data-state='copied'] :global(.btn) {
    border-color: var(--signal);
  }
  .pub__bib[data-state='failed'] :global(.btn) {
    border-color: var(--ink-3);
    color: var(--ink-2);
  }
  .pub__details pre {
    justify-self: stretch;
    margin: 0;
    padding: var(--space-2);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-1);
    color: var(--ink);
    font-size: var(--size-mono);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    -webkit-user-select: all;
    user-select: all;
  }
  @media (max-width: 640px) {
    .pub {
      grid-template-columns: minmax(0, 1fr);
    }
    .pub__id {
      display: none;
    }
  }
</style>

<script>
  const COPIED_MS = 2000;

  /* Clipboard API only; when it is unavailable the label points at the
     <pre> under the button, which selects as one block for a manual copy. */
  async function copyText(text: string): Promise<boolean> {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      return false;
    }
  }

  document.querySelectorAll<HTMLElement>('.pub__bib').forEach((wrap) => {
    const button = wrap.querySelector<HTMLButtonElement>('button');
    const label = button?.querySelector<HTMLElement>('.btn__label');
    const sourceId = button?.getAttribute('aria-controls');
    const source = sourceId ? document.getElementById(sourceId)?.querySelector('pre') : null;
    if (!button || !label || !source) return;
    const idle = label.textContent ?? 'Copy BibTeX';
    let timer: ReturnType<typeof setTimeout> | undefined;
    button.addEventListener('click', async () => {
      const ok = await copyText(source.textContent ?? '');
      label.textContent = ok ? 'Copied' : 'Copy failed; select the entry below';
      wrap.dataset.state = ok ? 'copied' : 'failed';
      clearTimeout(timer);
      timer = setTimeout(() => {
        label.textContent = idle;
        delete wrap.dataset.state;
      }, COPIED_MS);
    });
  });
</script>
