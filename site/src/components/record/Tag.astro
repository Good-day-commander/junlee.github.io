---
/*
  Short mono tag for identifiers and states (KR / US / PCT, INTL / DOMESTIC,
  REGISTERED, PRESENTER). Uppercase mono at 0.7rem is the one place the site
  allows uppercase outside frame corners. Rank by border ink, never by fill
  and never by signal (red is reserved for the nav Email, probes, active
  states and the focus ring):
    ink     primary-ink border: the state the reader is looking for (registered)
    soft    hairline, secondary ink (default)
*/
export interface Props {
  tone?: 'ink' | 'soft';
  title?: string;
  class?: string;
}
const { tone = 'soft', title, class: className } = Astro.props;
---

<span class:list={['tag', className]} data-tone={tone} title={title}><slot /></span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding: 0 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    /* The same mark as RoleMark ("First author"): sentence case in the UI face, not an uppercase tracked label. */
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--ink-2);
    white-space: nowrap;
    vertical-align: middle;
  }
  .tag[data-tone='ink'] {
    border-color: var(--ink);
    color: var(--ink);
  }
</style>
