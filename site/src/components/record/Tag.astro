---
/*
  Short mono tag for identifiers and states (KR / US / PCT, INTL / DOMESTIC,
  REGISTERED, PRESENTER). Uppercase mono at 0.7rem is the one place the site
  allows uppercase outside frame corners. Rank by border ink, never by fill:
    signal  the state the reader is looking for (registered, presenter)
    ink     a firm but neutral state
    soft    hairline, secondary ink (default)
*/
export interface Props {
  tone?: 'signal' | 'ink' | 'soft';
  title?: string;
  class?: string;
}
const { tone = 'soft', title, class: className } = Astro.props;
---

<span class:list={['tag', className]} data-tone={tone} title={title}><slot /></span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    min-height: 1.25rem;
    padding: 0 0.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: var(--size-label);
    line-height: 1;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
    color: var(--ink-2);
    white-space: nowrap;
    vertical-align: middle;
  }
  .tag[data-tone='ink'] {
    border-color: var(--ink-2);
    color: var(--ink);
  }
  .tag[data-tone='signal'] {
    border-color: var(--signal);
    color: var(--ink);
  }
</style>
