---
/*
  Author-role mark, bordered not filled. The role string comes straight from
  content.ts (publication.myRole) and is never inferred.
  Rank is carried by the border ink, not by weight or size:
    first      signal border, primary ink
    co-first   primary-ink border, primary ink
    co-author  hairline border, secondary ink
*/
import type { AuthorRole } from '@/data/content';

export interface Props {
  role: AuthorRole;
  class?: string;
}

const { role, class: className } = Astro.props;

const labels: Record<AuthorRole, string> = {
  first: 'First author',
  'co-first': 'Co-first author',
  'co-author': 'Co-author',
};
---

<span class:list={['rolemark', className]} data-role={role}>{labels[role]}</span>

<style>
  .rolemark {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding: 0 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.75rem;
    line-height: 1;
    letter-spacing: 0.01em;
    color: var(--ink-2);
    white-space: nowrap;
    vertical-align: middle;
  }
  .rolemark[data-role='first'] {
    border-color: var(--signal);
    color: var(--ink);
  }
  .rolemark[data-role='co-first'] {
    border-color: var(--ink);
    color: var(--ink);
  }
</style>
