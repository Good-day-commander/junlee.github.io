---
/*
  Thin top chrome: name left, Research / Publications / Record / CV right.
  The current page is marked with aria-current and a signal underline.
  On narrow screens the links stay a compact row (wrapping under the name
  when needed); there is no hamburger and no modal.
*/
import { profile } from '@/data/content';

const items = [
  { href: '/research', label: 'Research' },
  { href: '/publications', label: 'Publications' },
  { href: '/record', label: 'Record' },
  { href: '/cv', label: 'CV' },
];

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => current === href || current.startsWith(`${href}/`);
---

<header class="nav">
  <div class="nav__row wrap">
    <a class="nav__name" href="/" aria-current={current === '/' ? 'page' : undefined}>{profile.name}</a>
    <nav class="nav__links" aria-label="Primary">
      <ul>
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .nav__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    min-height: var(--nav-h);
  }
  .nav__name {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--size-ui);
    line-height: 1;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    padding-block: 0.9rem;
  }
  .nav__name[aria-current='page'] {
    color: var(--ink);
  }
  .nav__links ul {
    display: flex;
    gap: var(--space-3);
  }
  .nav__links a {
    display: inline-block;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--size-ui);
    line-height: 1;
    color: var(--ink-2);
    text-decoration: none;
    padding-block: 0.9rem;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition:
      color var(--duration-quick) var(--ease-out),
      border-color var(--duration-quick) var(--ease-out);
  }
  .nav__links a:hover {
    color: var(--ink);
  }
  .nav__links a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--signal);
  }
  @media (max-width: 480px) {
    .nav__links ul {
      gap: var(--space-2);
    }
    .nav__name,
    .nav__links a {
      font-size: 0.875rem;
      padding-block: 0.75rem;
    }
  }
</style>
