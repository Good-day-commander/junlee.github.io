---
/*
  Thin sticky top chrome, the same four items on every page and at every
  width: the name (home), Research, CV, and one Email action (signal fill,
  the page's one primary). Nothing else, no menu disclosure: the row fits a
  390 px phone. The full link row (CV (PDF), LinkedIn, Scholar, ORCID) is
  the footer's.

  Internal hrefs carry the trailing slash the static build serves, so a nav
  click never costs a redirect.
*/
import Button from '@/components/Button.astro';
import { profile } from '@/data/content';

const items = [
  { href: '/research/', label: 'Research' },
  { href: '/cv/', label: 'CV' },
];

const strip = (p: string) => p.replace(/\/+$/, '') || '/';
const current = strip(Astro.url.pathname);
const isCurrent = (href: string) => current === strip(href) || current.startsWith(`${strip(href)}/`);
---

<header class="nav">
  <div class="nav__row wrap">
    <a class="nav__name" href="/" aria-current={current === '/' ? 'page' : undefined}>{profile.name}</a>
    <nav class="nav__pages" aria-label="Primary">
      <ul class="nav__links">
        {
          items.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <Button href={`mailto:${profile.email}`} size="compact" class="nav__email">Email</Button>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .nav__row {
    display: flex;
    align-items: center;
    gap: 0 var(--space-3);
    min-height: var(--nav-h);
  }
  .nav__name {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--size-ui);
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    padding-block: 0.9rem;
    margin-right: auto;
  }
  .nav__links {
    display: flex;
    gap: var(--space-3);
  }
  .nav__links a {
    display: inline-block;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--size-ui);
    line-height: 1;
    color: var(--ink-2);
    text-decoration: none;
    padding-block: 0.9rem;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition:
      color var(--duration-quick) var(--ease-out),
      border-color var(--duration-quick) var(--ease-out);
  }
  .nav__links a:hover {
    color: var(--ink);
  }
  .nav__links a[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--signal);
  }

  @media (max-width: 480px) {
    .nav__row,
    .nav__links {
      gap: 0 var(--space-2);
    }
    .nav__name,
    .nav__links a {
      font-size: 0.875rem;
    }
  }
  /* Under 22rem (a phone at 200 % zoom): the row wraps instead of running off the screen. */
  @media (max-width: 21.98rem) {
    .nav__row {
      flex-wrap: wrap;
    }
  }
</style>
