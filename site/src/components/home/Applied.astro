---
/*
  "Applied": CARDIOS and EASYCHECK, two equal frames. Copy carried over from
  the legacy Home.tsx translational section (site-only material, not in the
  CV), cut to one sentence each; the company is named once in the lede, not
  repeated in every corner. Both frames end on the same kind of action, a
  quiet text link, so neither frame is half empty.

  The heading carries the product and what it is in one line. No corner or
  descriptor sits above a heading: the product class (SaMD) is said once,
  in the lede.
*/
import Frame from '@/components/Frame.astro';
import { publications } from '@/data/content';
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import arrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';

const J2 = publications.find((p) => p.id === 'J2');
const viscosityPaper = J2 ? `my ${J2.year} viscosity paper (${J2.id})` : 'my viscosity paper';

const company = 'The M.E.N.D. BioSimulator';

const products = [
  {
    name: 'CARDIOS',
    descriptor: 'coronary CT decision support',
    summary:
      'Estimates from coronary CT whether a lesion is functionally significant without an invasive pressure wire, combining anatomy, CFD-informed hemodynamics and deep learning.',
    link: { label: 'Overview on YouTube', href: 'https://www.youtube.com/watch?v=oSsvH7LRp7E', external: true },
  },
  {
    name: 'EASYCHECK',
    descriptor: 'wearable biomarker monitoring',
    summary: `A smartwatch app that reads PPG in real time to estimate blood pressure, non-Newtonian blood viscosity and hydration status, extending the research behind ${viscosityPaper}.`,
    link: { label: 'The research behind it', href: '/research/#pulse', external: false },
  },
];
---

<p class="applied__lede t-prose">
  Part of my research is carried into clinical software through <strong>{company}</strong>, a startup building SaMD
  products on the same coronary CFD, CT-FFR and wearable PPG work.
</p>

<ul class="applied">
  {
    products.map((p) => (
      <li>
        <Frame as="article" class="applied__frame" padded>
          <h3 class="applied__title t-subheading">
            <span class="applied__name">{p.name}</span>, {p.descriptor}
          </h3>
          <p class="applied__summary">{p.summary}</p>
          <a
            class="applied__link"
            href={p.link.href}
            rel={p.link.external ? 'noopener' : undefined}
            target={p.link.external ? '_blank' : undefined}
          >
            {p.link.label}
            <span class="applied__icon" aria-hidden="true" set:html={p.link.external ? arrowUpRight : arrowRight} />
          </a>
        </Frame>
      </li>
    ))
  }
</ul>

<style>
  .applied__lede {
    color: var(--ink-2);
    margin-bottom: var(--space-4);
  }
  .applied__lede strong {
    color: var(--ink);
    font-weight: 600;
  }
  .applied {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }
  /* Frame roots are child components; their class is unscoped, hence :global under .applied. */
  .applied :global(.applied__frame) {
    height: 100%;
  }
  .applied :global(.applied__frame > .frame__body) {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    height: 100%;
  }
  .applied__title {
    text-wrap: balance;
    max-width: 28ch;
    /* The product name holds the weight; the descriptor runs on in the same size at text weight. */
    font-weight: 400;
  }
  .applied__name {
    font-weight: 600;
  }
  .applied__summary {
    font-family: var(--font-text);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--ink-2);
    max-width: 52ch;
    text-wrap: pretty;
  }
  .applied__link {
    margin-top: auto;
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding-block: 0.4rem;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--size-ui);
    color: var(--ink);
    text-decoration-color: var(--line);
  }
  .applied__link:hover {
    text-decoration-color: var(--signal);
  }
  .applied__icon {
    display: inline-flex;
    width: 1em;
    height: 1em;
    color: var(--ink-3);
    transition: color var(--duration-quick) var(--ease-out);
  }
  .applied__icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .applied__link:hover .applied__icon {
    color: var(--signal);
  }
  @media (max-width: 899px) {
    .applied {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
