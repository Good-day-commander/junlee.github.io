---
/*
  Close: the primary Email action restated, the address in mono, and the
  three profile links. Same link pattern as Footer (Phosphor arrow inline).
*/
import Button from '@/components/Button.astro';
import { profile } from '@/data/content';
import envelope from '@phosphor-icons/core/assets/regular/envelope.svg?raw';
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';

const links = [
  { label: 'Google Scholar', href: profile.links.scholar },
  { label: 'LinkedIn', href: profile.links.linkedin },
  { label: 'ORCID', href: profile.links.orcid },
];
---

<div class="contact">
  <p class="contact__lede t-prose">
    For collaboration, a position, or a copy of a paper, email is the fastest route. Replies come from Seoul (UTC+9).
  </p>
  <div class="contact__actions">
    <Button href={`mailto:${profile.email}`}>
      Email
      <span slot="icon" aria-hidden="true" set:html={envelope} />
    </Button>
    <a class="contact__address t-mono" href={`mailto:${profile.email}`}>{profile.email}</a>
  </div>
  <ul class="contact__links">
    {
      links.map((l) => (
        <li>
          <a class="contact__link" href={l.href} rel="me noopener">
            <span>{l.label}</span>
            <span class="contact__icon" aria-hidden="true" set:html={arrowUpRight} />
          </a>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .contact {
    display: grid;
    gap: var(--space-3);
  }
  .contact__lede {
    color: var(--ink-2);
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .contact__address {
    font-size: var(--size-ui);
    color: var(--ink);
    text-decoration-color: var(--line);
  }
  .contact__address:hover {
    text-decoration-color: var(--signal);
  }
  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
  }
  .contact__link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--size-ui);
    color: var(--ink);
    text-decoration: none;
    padding-block: 0.5rem;
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-quick) var(--ease-out);
  }
  .contact__link:hover {
    border-bottom-color: var(--signal);
  }
  .contact__icon {
    display: inline-flex;
    width: 1em;
    height: 1em;
    color: var(--ink-3);
    transition: color var(--duration-quick) var(--ease-out);
  }
  .contact__icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .contact__link:hover .contact__icon {
    color: var(--signal);
  }
</style>
