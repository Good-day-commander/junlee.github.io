---
/*
  About: who I am, in three STIX sentences built from content.ts (role and
  lab with the PI, the concurrent hospital project with its PI, the Ph.D.
  with the dissertation, the B.Eng.), beside the ID portrait used small
  (a 160px square plate with a hairline, never hero material) and one
  conference photograph as evidence of the work being presented. A mono
  line of the five ways to reach me closes the block.

  Photos are optimized by astro:assets from src/assets/photos.
*/
import { Image } from 'astro:assets';
import { education, profile, talks } from '@/data/content';
import portrait from '@/assets/photos/profile-main.jpg';
import podium from '@/assets/photos/gallery-acfm-2025.jpg';

const phd = education.find((e) => /^Ph\.D\./.test(e.degree));
const beng = education.find((e) => /^B\.Eng\./.test(e.degree));
const firstClause = (s: string) => s.split(',')[0].trim();
const concurrentPi = firstClause(profile.concurrent.pi);
/* "Ph.D. in Mechanical Engineering (Integrated M.S.–Ph.D. Program)" → "Ph.D. in Mechanical Engineering" */
const phdDegree = phd ? phd.degree.replace(/\s*\(.*\)$/, '') : 'Ph.D.';

/* The podium photo documents the ACFM 2025 talk; its caption is read from that talk record. */
const acfm = talks.find((t) => /ACFM/.test(t.venue) && t.year === '2025');
const acfmShort = acfm ? `ACFM ${acfm.year}, ${acfm.location.split(',')[0]}` : 'ACFM 2025';

const links = [
  { label: 'Email', href: `mailto:${profile.email}` },
  { label: 'CV (PDF)', href: '/uploads/resume.pdf', external: true },
  { label: 'LinkedIn', href: profile.links.linkedin, me: true },
  { label: 'Google Scholar', href: profile.links.scholar, me: true },
  { label: 'ORCID', href: profile.links.orcid, me: true },
];
---

<div class="about">
  <figure class="about__portrait">
    <Image
      src={portrait}
      alt={`${profile.name}, portrait.`}
      width={portrait.width}
      height={portrait.height}
      format="webp"
      quality={85}
      loading="lazy"
      class="about__portrait-img"
    />
  </figure>

  <div class="about__text">
    <p class="t-prose about__prose">
      I am a {profile.role.toLowerCase()} in the {profile.lab} at {profile.university}, working with {profile.pi},
      and a {profile.concurrent.role.toLowerCase()} on the {profile.concurrent.org} {profile.concurrent.project} with{' '}
      {concurrentPi}.
      {
        phd && (
          <>
            {' '}
            I completed my {phdDegree} at {phd.institution} in <time>{profile.phdCompleted}</time>, with the dissertation{' '}
            <cite>{profile.phdDissertation}</cite>.
          </>
        )
      }
      {
        beng && (
          <>
            {' '}
            Before that I took a {beng.degree} at {beng.institution}.
          </>
        )
      }
    </p>
    <ul class="about__links t-mono">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              rel={l.me ? 'me noopener' : l.external ? 'noopener' : undefined}
              target={l.external ? '_blank' : undefined}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <figure class="about__photo">
    <Image
      src={podium}
      alt={acfm ? `${profile.name} presenting at the podium of the ${acfm.venue}, ${acfm.location}.` : `${profile.name} presenting at a conference podium.`}
      width={480}
      widths={[240, 360, 480]}
      sizes="(min-width: 900px) 15rem, 40vw"
      format="webp"
      quality={78}
      loading="lazy"
      class="about__photo-img"
    />
    <figcaption class="about__caption t-mono">
      {acfmShort}
      {acfm && <a href={`/record/#${acfm.id}`}>Oral, presenter</a>}
    </figcaption>
  </figure>
</div>

<style>
  .about {
    display: grid;
    grid-template-columns: 10rem minmax(0, 40rem) 15rem;
    justify-content: start;
    gap: var(--space-4) var(--space-5);
    align-items: start;
  }
  .about__portrait,
  .about__photo {
    margin: 0;
  }
  /* The ID portrait: a 160px square plate with a hairline, face held near the top third. */
  .about__portrait :global(.about__portrait-img) {
    width: 10rem;
    height: 10rem;
    object-fit: cover;
    object-position: 50% 28%;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-1);
  }
  .about__text {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }
  .about__prose {
    color: var(--ink);
  }
  .about__prose cite {
    font-style: italic;
  }
  /* A date inside a sentence reads in the sentence's serif, not as a mono readout. */
  .about__prose time {
    font-family: inherit;
  }
  .about__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem var(--space-3);
  }
  .about__links a {
    display: inline-block;
    padding-block: 0.35rem;
    color: var(--ink);
    text-decoration-color: var(--line);
  }
  .about__links a:hover {
    text-decoration-color: var(--signal);
  }
  .about__photo {
    display: grid;
    gap: var(--space-1);
  }
  .about__photo :global(.about__photo-img) {
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-1);
  }
  .about__caption {
    display: flex;
    flex-wrap: wrap;
    gap: 0 0.6rem;
    font-size: var(--size-label);
    color: var(--ink-2);
  }
  .about__caption a {
    color: var(--ink-2);
    text-decoration-color: var(--line);
  }
  .about__caption a:hover {
    color: var(--ink);
    text-decoration-color: var(--signal);
  }

  @media (max-width: 1023px) {
    .about {
      grid-template-columns: 8rem minmax(0, 1fr);
      justify-content: stretch;
    }
    .about__portrait :global(.about__portrait-img) {
      width: 8rem;
      height: 8rem;
    }
    .about__photo {
      grid-column: 2;
      max-width: 15rem;
    }
  }
  @media (max-width: 599px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
    .about__portrait :global(.about__portrait-img) {
      width: 7rem;
      height: 7rem;
    }
    .about__photo {
      grid-column: auto;
      max-width: 12rem;
    }
  }
</style>
