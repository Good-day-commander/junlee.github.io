---
/*
  First viewport: a full-viewport cine frame on film. The vessel (WebGL,
  pressure-painted) fills the frame; mono readouts sit in the corners; the
  headline block is the bottom-left corner. On narrow screens the frame goes
  portrait and the headline moves below it.

  Corner readouts are rendered here rather than through Frame's tl/tr props
  because they run to several lines (Frame corners are single-line strings).
  They reuse the global .frame__corner classes.

  Every number comes from the PINO manifest or content.ts.
*/
import Frame from '@/components/Frame.astro';
import Button from '@/components/Button.astro';
import HeroViewer from './HeroViewer';
import { profile } from '@/data/content';
import { formatInt, formatPaRange } from '@/lib/format';
import { shortGpu, type PinoManifest } from './manifests';
import envelope from '@phosphor-icons/core/assets/regular/envelope.svg?raw';
import filePdf from '@phosphor-icons/core/assets/regular/file-pdf.svg?raw';
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';

export interface Props {
  pino: PinoManifest;
}

const { pino } = Astro.props;

const headline = 'Coronary physics, fast enough for the clinic.';
const fronts = ['Coronary hemodynamics', 'Physics-informed AI', 'Wearable PPG'];

/*
  Corner readouts are stacked lines, one token per line, like the annotation
  block of a cine frame: no chained separators, nothing left to wrap.
*/
const caseTokens = [pino.case_id, `${formatInt(pino.vertexCount)} nodes`, formatPaRange(pino.ranges.p[0], pino.ranges.p[1])];
const inferenceSeconds = pino.timing.pino.inference_ms_median / 1000;
const gpu = shortGpu(pino.timing.pino.gpu);

/* One sentence, under 20 words: the role, the lab, and the concurrent hospital project. */
const initials = (s: string) =>
  s
    .split(/\s+/)
    .map((w) => w[0])
    .join('')
    .toUpperCase();
const concurrentOrg = profile.concurrent.org;
const concurrentAbbr = initials(concurrentOrg);

/*
  The hairline starts at 68 % of the frame: on the vessel, in the gap between
  the two-line headline (which ends near 62 % of the frame at 1440 wide) and
  the top-right case readout (which starts near 72 %), so the signature
  control crosses neither the display type nor the corner chrome.
*/
const initialWipe = 0.68;
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="wrap hero__grid">
    <Frame class="hero__frame">
      <HeroViewer
        client:load
        manifestUrl="/data/pino/manifest.json"
        inferenceSeconds={inferenceSeconds}
        ffrCfd={pino.metrics.case.ffr.cfd}
        ffrPino={pino.metrics.case.ffr.pino}
        gpu={gpu}
        initialWipe={initialWipe}
      />
      <p class="frame__corner frame__corner--tl hero__corner">
        <span class="hero__corner-line frame__corner--caps hero__name">{profile.name}</span>
        {fronts.map((f) => <span class="hero__corner-line">{f}</span>)}
      </p>
      <p class="frame__corner frame__corner--tr hero__corner">
        {
          caseTokens.map((t, i) => (
            <span class:list={['hero__corner-line', { 'hero__token--range': i === caseTokens.length - 1 }]}>{t}</span>
          ))
        }
      </p>
    </Frame>

    <div class="hero__head">
      <h1 id="hero-heading" class="t-display hero__title">{headline}</h1>
      <p class="hero__role">
        {profile.role}, {profile.lab}, {profile.university}, and {profile.concurrent.role.toLowerCase()} on the{' '}
        <abbr title={concurrentOrg}>{concurrentAbbr}</abbr>
        {profile.concurrent.project}.
      </p>
      <div class="hero__actions">
        <Button href={`mailto:${profile.email}`}>
          Email
          <span slot="icon" aria-hidden="true" set:html={envelope} />
        </Button>
        <Button variant="ghost" href="/uploads/resume.pdf" external>
          CV (PDF)
          <span slot="icon" aria-hidden="true" set:html={filePdf} />
        </Button>
        <a class="hero__quiet" href={profile.links.linkedin} rel="me noopener">
          LinkedIn<span class="hero__quiet-icon" aria-hidden="true" set:html={arrowUpRight} />
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: var(--space-2) 0;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  /*
    Desktop: frame and headline share one cell; the headline is the bottom-left corner.
    Frame is a child component, so a class passed to it is not scoped by Astro:
    its rules are written through :global under .hero__grid.
  */
  .hero__grid > :global(.hero__frame) {
    grid-area: 1 / 1;
    min-height: calc(100dvh - var(--nav-h) - var(--space-2) * 2);
    overflow: hidden;
    isolation: isolate;
    /* The full-viewport frame gives its corner chrome a wider inset than a card-sized frame. */
    --corner-inset: 0.875rem;
  }
  /* The viewer fills the frame instead of setting the frame's height. */
  .hero__grid > :global(.hero__frame > .frame__body) {
    position: absolute;
    inset: 0;
  }
  :global(.hero__viewer) {
    position: absolute;
    inset: 0;
  }
  :global(.hero__viewer > *) {
    width: 100%;
    height: 100%;
  }

  /* Corner readouts: two-line variants of the frame corner chrome. */
  :global(.hero__corner) {
    display: grid;
    gap: 0.15rem;
    max-width: 46%;
    white-space: normal;
    color: var(--ink-2);
  }
  :global(.hero__corner.frame__corner--tr),
  :global(.hero__corner.frame__corner--br) {
    justify-items: end;
  }
  :global(.hero__corner-line),
  :global(.hero__readout-line) {
    display: block;
    white-space: nowrap;
  }
  /* The name heads the block; the fronts sit under it a step quieter. */
  .hero__name {
    color: var(--ink);
    margin-bottom: 0.15rem;
  }
  :global(.hero__readout) {
    color: var(--ink);
  }
  :global(.hero__count) {
    display: inline-block;
    min-width: 5ch;
    text-align: right;
    color: var(--signal);
  }

  .hero__head {
    grid-area: 1 / 1;
    align-self: end;
    justify-self: start;
    position: relative;
    z-index: 3;
    display: grid;
    gap: var(--space-3);
    max-width: min(100%, 62rem);
    padding: calc(var(--corner-inset, 0.5rem) + var(--space-3));
    padding-right: var(--space-4);
  }
  /* Two lines at desktop widths: "Coronary physics, fast enough / for the clinic." */
  .hero__title {
    max-width: 22ch;
    color: var(--ink);
  }
  .hero__role {
    font-family: var(--font-text);
    font-size: var(--size-prose);
    line-height: var(--leading-prose);
    color: var(--ink-2);
    max-width: 52ch;
    text-wrap: pretty;
  }
  .hero__role abbr {
    text-decoration: none;
    cursor: help;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }
  .hero__quiet {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-left: var(--space-1);
    padding-block: 0.6rem;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--size-ui);
    line-height: 1.2;
    color: var(--ink-2);
    text-decoration-color: var(--line);
  }
  .hero__quiet:hover {
    color: var(--ink);
    text-decoration-color: var(--signal);
  }
  .hero__quiet-icon {
    display: inline-flex;
    width: 1em;
    height: 1em;
    color: var(--ink-3);
    transition: color var(--duration-quick) var(--ease-out);
  }
  .hero__quiet-icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .hero__quiet:hover .hero__quiet-icon {
    color: var(--signal);
  }

  /*
    Narrow screens: portrait frame, headline below it. The frame is held to
    about half the viewport so the headline, the role line and both actions
    land inside the first screen of a 390 x 844 phone.
  */
  @media (max-width: 899px) {
    .hero__grid {
      grid-template-rows: auto auto;
      row-gap: var(--space-3);
    }
    .hero__grid > :global(.hero__frame) {
      grid-area: 1 / 1;
      min-height: 0;
      aspect-ratio: 3 / 4;
      max-height: min(50svh, 30rem);
      width: 100%;
    }
    .hero__head {
      grid-area: 2 / 1;
      max-width: none;
      padding: 0;
      gap: var(--space-2);
    }
    :global(.hero__corner) {
      max-width: 60%;
    }
    :global(.hero__corner.frame__corner--tr) {
      max-width: 38%;
    }
    /* The colorbar below already carries the kPa range on a phone; the corner keeps case id and node count. */
    .hero__token--range {
      display: none;
    }
  }
</style>
