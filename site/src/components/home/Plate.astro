---
/*
  The home plate: one live cine frame under the identity block and its
  Updates row. The VesselViewer runs quiet (pressure field
  only, the CFD | PINO wipe, the colorbar, the develop once, nothing in the
  corners; the idle drift stays on), hydrates when visible and preloads
  nothing. The frame is film in both schemes (Frame plate).

  Under the frame, in Astro so the numbers are in the server HTML: one
  STIX line (lib/schema.ts plateSentence, numbers interpolated) with the
  CFD and PINO FFR readings, the CFD bound and the PINO time. There is no
  mono caption line and no case identifier on the plate. No link here: the
  Work rows link the research projects. No speed-up factor is printed.

  The poster: the plate's own still (scripts/vessel-still.mjs; the 2:1 one
  is the same render as the no-WebGL fallback), a server-rendered
  <picture> under the canvas, so the plate is never a blank film before
  the vessel draws, on a slow network or without JS. The 3:4 phone plate
  takes the portrait still, where the live vessel is framed upright; each
  width downloads one of the two. The canvas is transparent around the
  vessel, so the poster leaves once the viewer is past loading: after the
  canvas has faded in, or under a failed load's sentence. The drift is
  untouched.
*/
import Frame from '@/components/Frame.astro';
import poster from '@/assets/plate/vessel-poster.webp';
import posterPortrait from '@/assets/plate/vessel-poster-portrait.webp';
import HeroViewer from './HeroViewer';
import { DEFAULT_SUMMARY, DEFAULT_MANIFEST_URL } from '@/islands/vessel/summary';
import { plateSentence } from '@/lib/schema';
---

<section class="home-plate wrap" aria-label="Live plate: CFD against the neural operator on one patient vessel">
  <Frame plate class="home-plate__frame">
    <picture>
      <source media="(max-width: 899px)" srcset={posterPortrait.src} width={posterPortrait.width} height={posterPortrait.height} />
      <img class="home-plate__poster" src={poster.src} width={poster.width} height={poster.height} alt="" decoding="async" />
    </picture>
    <HeroViewer client:visible quiet manifestUrl={DEFAULT_MANIFEST_URL} summary={DEFAULT_SUMMARY} />
  </Frame>
  <div class="home-plate__under">
    <p class="home-plate__line">{plateSentence}</p>
  </div>
</section>

<style>
  .home-plate {
    display: grid;
    gap: var(--space-2);
  }
  /*
    The frame holds a positioned viewer; its body fills the frame. Capped at
    min(44vh, 30rem) (396 px at 900) so identity, plate, the caption line
    and the STIX line all end inside the 1440 x 900 first viewport.
  */
  .home-plate > :global(.home-plate__frame) {
    position: relative;
    height: auto;
    aspect-ratio: 2 / 1;
    max-height: 60vh;
    min-height: 16rem;
    overflow: hidden;
    isolation: isolate;
  }
  .home-plate > :global(.home-plate__frame > .frame__body) {
    position: absolute;
    inset: 0;
  }
  .home-plate :global(.hero__viewer) {
    position: absolute;
    inset: 0;
  }
  .home-plate :global(.hero__viewer > *) {
    width: 100%;
    height: 100%;
  }
  /* Under the viewer (it comes first in the body); it leaves after the canvas has faded in. */
  .home-plate__poster {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
    transition: opacity var(--duration-base) var(--ease-out) var(--duration-base);
  }
  :global(.home-plate:has([data-island='VesselViewer']:not([data-status='loading'])) .home-plate__poster) {
    opacity: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .home-plate__poster {
      transition: none;
    }
  }
  .home-plate__under {
    display: grid;
    gap: 0.35rem;
  }
  .home-plate__caption {
    display: grid;
    gap: 0.1rem;
    color: var(--ink-2);
  }
  .home-plate__line {
    font-family: var(--font-text);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .home-plate__pair {
    white-space: nowrap;
  }

  /* Phones: the frame goes portrait under the identity block. */
  @media (max-width: 899px) {
    .home-plate > :global(.home-plate__frame) {
      height: auto;
      min-height: 0;
      aspect-ratio: 3 / 4;
      max-height: none; /* full column width; the desktop height cap narrowed the plate on short viewports */
    }
  }
</style>
