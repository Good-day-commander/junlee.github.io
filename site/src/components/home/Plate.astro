---
/*
  The home plate: one live cine frame under the identity block, in the same
  first viewport at 1440 x 900. The VesselViewer runs quiet (pressure field
  only, the CFD | PINO wipe, the colorbar, the develop once, nothing in the
  corners), hydrates when visible and preloads nothing. The frame is film
  in both schemes (Frame plate).

  Under the frame, in Astro so the numbers are in the server HTML: one
  mono caption line (case id, nodes, FFR CFD / PINO from the PINO
  manifest, through lib/schema.ts plateCaptionItems) and one STIX line
  (lib/schema.ts plateSentence, numbers interpolated) that carries the CFD
  bound against the PINO time and says "slide or toggle", since phones
  show a toggle, not a handle. The timing pair is not repeated as a second
  caption line (round 3b): proof line 2 and the sentence already state it
  in this viewport; timingItems stays in schema.ts for the Flow header and
  the agent files. No link here: the Simulation row links to the Flow
  chapter. Each value pair in the caption is one nowrap span, so phones
  break only between pairs. No speed-up factor is printed.
*/
import Frame from '@/components/Frame.astro';
import HeroViewer from './HeroViewer';
import { DEFAULT_SUMMARY, DEFAULT_MANIFEST_URL } from '@/islands/vessel/summary';
import { plateSentence } from '@/lib/schema';
---

<section class="home-plate wrap" aria-label="Live plate: CFD against the neural operator on one patient vessel">
  <Frame plate class="home-plate__frame">
    <HeroViewer client:visible quiet manifestUrl={DEFAULT_MANIFEST_URL} summary={DEFAULT_SUMMARY} />
  </Frame>
  <div class="home-plate__under">
    <p class="home-plate__line">{plateSentence}</p>
  </div>
</section>

<style>
  .home-plate {
    display: grid;
    gap: var(--space-2);
  }
  /*
    The frame holds a positioned viewer; its body fills the frame. Capped at
    min(44vh, 30rem) (396 px at 900) so identity, plate, the caption line
    and the STIX line all end inside the 1440 x 900 first viewport.
  */
  .home-plate > :global(.home-plate__frame) {
    position: relative;
    height: min(44vh, 30rem);
    min-height: 18rem;
    overflow: hidden;
    isolation: isolate;
  }
  .home-plate > :global(.home-plate__frame > .frame__body) {
    position: absolute;
    inset: 0;
  }
  .home-plate :global(.hero__viewer) {
    position: absolute;
    inset: 0;
  }
  .home-plate :global(.hero__viewer > *) {
    width: 100%;
    height: 100%;
  }
  .home-plate__under {
    display: grid;
    gap: 0.35rem;
  }
  .home-plate__caption {
    display: grid;
    gap: 0.1rem;
    color: var(--ink-2);
  }
  .home-plate__line {
    font-family: var(--font-text);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 62ch;
    text-wrap: pretty;
  }
  .home-plate__pair {
    white-space: nowrap;
  }

  /* Phones: the frame goes portrait under the identity block. */
  @media (max-width: 899px) {
    .home-plate > :global(.home-plate__frame) {
      height: auto;
      min-height: 0;
      aspect-ratio: 3 / 4;
      max-height: 64svh;
    }
  }
</style>
