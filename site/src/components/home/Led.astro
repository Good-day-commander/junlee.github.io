---
/*
  "Led work": an instrument strip of counts, one honours line, the led works
  as frames whose size carries rank, then the co-authored work as a compact
  list. Published first-author papers (C1, J2) take the wide left column;
  the first-author manuscript under revision (M1) and the co-first paper
  (J4) run narrower on the right, newest beside newest.

  Each frame reads in the one anatomy the site uses for a paper: title,
  authors, venue with the DOI, then the role mark at the end of that row,
  then the one sentence on my part, pinned to the frame's foot so paired
  frames end on one line.
  Everything is computed from content.ts: roles from myRole, counts from the
  arrays, honours from awards[] / fellowships[], the contribution from the
  experience bullet tagged with the publication id (e.g. "... [J2]").
*/
import Frame from '@/components/Frame.astro';
import RoleMark from '@/components/RoleMark.astro';
import { awards, experience, fellowships, patents, projects, publications, talks } from '@/data/content';
import type { Award, Publication } from '@/data/content';
import { formatInt } from '@/lib/format';
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import arrowRight from '@phosphor-icons/core/assets/regular/arrow-right.svg?raw';

const yearNum = (p: Publication) => (p.year ? Number(p.year) : -1);
const isRev = (p: Publication) => p.type === 'under-review';
const led = publications.filter((p) => p.myRole === 'first' || p.myRole === 'co-first');
const coauthored = publications.filter((p) => p.myRole === 'co-author').sort((a, b) => yearNum(b) - yearNum(a));

/*
  Rank → frame size. A published first-author paper is a lead and takes the
  wide column, newest first; everything else takes the narrow column, the
  manuscript under revision first, then by year. Row n pairs the n-th lead
  with the n-th narrow frame, so both columns read newest at the top.
*/
const isLead = (p: Publication) => p.myRole === 'first' && !isRev(p);
const leads = led.filter(isLead).sort((a, b) => yearNum(b) - yearNum(a));
const sides = led
  .filter((p) => !isLead(p))
  .sort((a, b) => Number(isRev(b)) - Number(isRev(a)) || yearNum(b) - yearNum(a));
const placed = [
  ...leads.map((p, i) => ({ p, lead: true, row: i + 1, col: 1 })),
  ...sides.map((p, i) => ({ p, lead: false, row: i + 1, col: 2 })),
];

/** The experience bullet tagged [ID] (or [ID, …]) as one clean sentence. */
function contribution(id: string): string | undefined {
  const tag = new RegExp(`\\[(?:[A-Z]\\d+,\\s*)*${id}(?:,\\s*[A-Z]\\d+)*\\]`);
  for (const job of experience) {
    for (const bullet of job.bullets) {
      if (!tag.test(bullet)) continue;
      let s = bullet
        .replace(tag, '')
        .replace(/^[^:]{3,40}:\s*/, '')
        .replace(/\s+([;,.])/g, '$1')
        .trim();
      // A bullet that runs on past its claim ("…spectrograms; blood pressure, …") ends at the claim.
      const semi = s.indexOf(';');
      if (semi > 0) s = s.slice(0, semi);
      s = s.replace(/[.;,\s]+$/, '');
      return `${s.charAt(0).toUpperCase()}${s.slice(1)}.`;
    }
  }
  return undefined;
}

const doiUrl = (p: Publication) => (p.doi ? `https://doi.org/${p.doi}` : undefined);

function venueLine(p: Publication): string {
  const parts = [p.venueShort ?? p.venue];
  if (p.volume) parts.push(p.article ? `${p.volume}, ${p.article}` : p.pages ? `${p.volume}, ${p.pages}` : p.volume);
  const head = parts.join(' ');
  // A proceedings venue already names its year ("Proc. ASME 2026 …"); do not print it twice.
  return p.year && !head.includes(p.year) ? `${head} (${p.year})` : head;
}

/**
  Venue for the led frames: always the full journal name. A manuscript's one
  status label, "under revision (EAAI)", sits in the frame's corner instead
  of the year, as on /publications.
*/
function leadVenue(p: Publication): string {
  if (!isRev(p)) return venueLine(p);
  return p.venue;
}

const awardsFor = (id: string) => awards.filter((a) => a.forPublication === id);

// Counts: the instrument strip.
const scie = publications.filter((p) => p.type === 'journal').length;
const proceedings = publications.filter((p) => p.type === 'proceedings').length;
const publicPatents = patents.filter((p) => p.status !== 'withdrawn');
const registered = publicPatents.filter((p) => p.status === 'registered').length;
const presented = talks.filter((t) => t.role === 'presenter').length;

const readout = [
  { n: scie, label: 'SCIE articles' },
  { n: proceedings, label: 'proceedings papers' },
  { n: publicPatents.length, label: 'patents', note: `${formatInt(registered)} registered` },
  { n: projects.length, label: 'funded projects' },
  { n: talks.length, label: 'talks', note: `${formatInt(presented)} presented` },
  { n: awards.length, label: 'awards', note: `${formatInt(fellowships.length)} fellowships` },
];

/*
  Honours line: the paper award tied to a led paper, the society award, and
  the longest fellowship, each worded from its record.
*/
const acronym = (org: string) => org.match(/\(([A-Z0-9]+)\)/)?.[1];
const paperAward = awards.find((a) => a.forPublication && led.some((p) => p.id === a.forPublication));
const societyAward = awards.find((a) => a !== paperAward && acronym(a.org));
const fellowship = fellowships.find((f) => /BK21 FOUR/.test(f.title));
const honourLabel = (a: Award) =>
  a.forPublication ? `${a.title} ${a.year} (${a.forPublication})` : `${acronym(a.org) ?? a.org} ${a.title} ${a.year}`;
const honours = [
  paperAward && honourLabel(paperAward),
  societyAward && honourLabel(societyAward),
  fellowship && fellowship.title.replace(/\s*\(([^)]+)\)$/, ', $1'),
].filter((h): h is string => Boolean(h));
---

<ul class="strip t-mono" aria-label="Counts">
  {
    readout.map((r) => (
      <li class="strip__cell">
        <span class="strip__n">{formatInt(r.n)}</span>
        <span class="strip__label">{r.label}</span>
        {r.note && <span class="strip__note">{r.note}</span>}
      </li>
    ))
  }
</ul>

{
  honours.length > 0 && (
    <div class="honours">
      <ul class="honours__list t-mono" aria-label="Honours">
        {honours.map((h) => (
          <li class="honours__item">{h}</li>
        ))}
      </ul>
      <a class="honours__link" href="/record/#awards">
        Awards and fellowships
        <span class="arrow" aria-hidden="true" set:html={arrowRight} />
      </a>
    </div>
  )
}

<ol class="led">
  {
    placed.map(({ p, lead, row, col }) => {
      const url = doiUrl(p);
      const text = contribution(p.id);
      const won = awardsFor(p.id);
      return (
        <li class:list={['led__cell', { 'led__cell--lead': lead }]} style={`--row: ${row}; --col: ${col};`}>
          <Frame
            as="article"
            class:list={['led__frame', { 'led__frame--lead': lead }]}
            padded
            tl={p.id}
            tr={p.year || (isRev(p) ? `under revision (${p.venueShort ?? p.venue})` : undefined)}
          >
            <h3 class="frame__what led__title">
              {url ? (
                <a href={url} rel="noopener">
                  {p.title}
                  <span class="led__arrow" aria-hidden="true" set:html={arrowUpRight} />
                </a>
              ) : (
                p.title
              )}
            </h3>
            <p class="led__authors">{p.authors}</p>
            <p class="led__venue frame__result">
              <span class="led__venue-text">
                {leadVenue(p)}
              </span>
              {p.doi && (
                <a class="led__doi" href={url} rel="noopener">
                  doi:{p.doi}
                </a>
              )}
              <RoleMark role={p.myRole} />
            </p>
            {won.map((a) => (
              <p class="led__award t-mono">
                {a.year} {a.title}, {a.org}
              </p>
            ))}
            {text && (
              <div class="led__part">
                <p class="frame__consequence">{text}</p>
              </div>
            )}
          </Frame>
        </li>
      );
    })
  }
</ol>

<h3 class="co__heading t-subheading">Co-authored</h3>
<ol class="co">
  {
    coauthored.map((p) => {
      const url = doiUrl(p);
      return (
        <li class="co__row">
          <span class="co__id t-mono">{p.id}</span>
          <div class="co__main">
            {url ? (
              <a class="co__title" href={url} rel="noopener">
                {p.title}
              </a>
            ) : (
              <span class="co__title">{p.title}</span>
            )}
            <span class="co__authors">{p.authors}</span>
          </div>
          <span class="co__venue t-mono">{venueLine(p)}</span>
          <RoleMark role={p.myRole} class="co__role" />
        </li>
      );
    })
  }
</ol>

<p class="more">
  <a href="/publications/">All publications</a>
  <a href="/record/">Talks, patents, projects, awards</a>
</p>

<style>
  /* Instrument strip: hairline-divided cells, the count in primary ink, no separators to orphan. */
  .strip {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    border-block: 1px solid var(--line);
    margin-bottom: var(--space-2);
  }
  .strip__cell {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: baseline;
    gap: 0.15rem 0.5rem;
    padding: 0.75rem var(--space-2);
    border-left: 1px solid var(--line-soft);
  }
  .strip__cell:first-child {
    border-left: 0;
    padding-left: 0;
  }
  .strip__n {
    font-size: 1.25rem;
    line-height: 1;
    color: var(--ink);
  }
  .strip__label {
    min-width: 0;
    color: var(--ink-2);
    font-size: var(--size-mono);
    overflow-wrap: normal;
    hyphens: none;
  }
  .strip__note {
    grid-column: 2;
    color: var(--ink-3);
    font-size: var(--size-label);
  }

  /* Honours: hairline-divided items like the strip above, no chained separators. */
  .honours {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem var(--space-3);
    margin-bottom: var(--space-5);
  }
  .honours__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0;
    color: var(--ink-2);
  }
  .honours__item {
    padding-inline: var(--space-2);
    border-left: 1px solid var(--line-soft);
    white-space: nowrap;
  }
  .honours__item:first-child {
    padding-left: 0;
    border-left: 0;
  }
  .honours__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--ink);
    white-space: nowrap;
    text-decoration-color: var(--line);
  }
  .honours__link:hover {
    text-decoration-color: var(--signal);
  }
  .arrow {
    display: inline-flex;
    width: 1em;
    height: 1em;
    color: var(--ink-3);
  }
  .arrow :global(svg) {
    width: 100%;
    height: 100%;
  }
  .honours__link:hover .arrow {
    color: var(--signal);
  }

  /* Wide column for the leads, narrow for the rest; rows are placed from the frontmatter. */
  .led {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: var(--space-2);
  }
  .led__cell {
    grid-row: var(--row);
    grid-column: var(--col);
    min-width: 0;
  }
  /* Frame roots are child components; their class is unscoped, hence :global under .led. */
  .led :global(.led__frame) {
    height: 100%;
    display: flex;
    flex-direction: column;
  }
  .led :global(.led__frame > .frame__body) {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .led :global(.led__frame--lead > .frame__body) {
    padding-inline: var(--space-4);
  }
  /* The lead frame sets its title a step larger; type weight stays even. */
  .led__title {
    max-width: 44ch;
  }
  .led :global(.led__frame--lead) .led__title {
    font-size: 1.5rem;
    line-height: 1.32;
  }
  .led__title a {
    text-decoration-color: transparent;
  }
  .led__title a:hover {
    text-decoration-color: var(--signal);
  }
  .led__arrow {
    display: inline-block;
    width: 0.7em;
    height: 0.7em;
    margin-left: 0.3em;
    vertical-align: baseline;
    color: var(--ink-3);
  }
  .led__arrow :global(svg) {
    width: 100%;
    height: 100%;
  }
  .led__title a:hover .led__arrow {
    color: var(--signal);
  }
  .led__venue {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.75rem;
  }
  .led__venue abbr {
    text-decoration: none;
    cursor: help;
  }
  .led__doi {
    color: var(--ink-2);
    text-decoration-color: var(--line);
  }
  .led__doi:hover {
    text-decoration-color: var(--signal);
  }
  .led__authors {
    font-family: var(--font-text);
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .led__award {
    color: var(--ink);
  }
  /* My part: pinned to the frame foot under a hairline, so paired frames end together. */
  .led__part {
    margin-top: auto;
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
  }
  .led__part > p {
    max-width: 62ch;
  }

  .co__heading {
    margin-top: var(--space-6);
    margin-bottom: var(--space-2);
  }
  .co {
    border-top: 1px solid var(--line);
  }
  .co__row {
    display: grid;
    grid-template-columns: 3ch minmax(0, 1fr) auto auto;
    gap: var(--space-1) var(--space-3);
    align-items: baseline;
    padding-block: var(--space-2);
    border-bottom: 1px solid var(--line);
  }
  .co__id {
    color: var(--ink-3);
  }
  .co__main {
    display: grid;
    gap: 0.2rem;
  }
  .co__title {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--ink);
    text-wrap: pretty;
  }
  a.co__title {
    text-decoration-color: transparent;
  }
  a.co__title:hover {
    text-decoration-color: var(--signal);
  }
  .co__authors {
    font-family: var(--font-text);
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--ink-2);
  }
  .co__venue {
    color: var(--ink-2);
    text-align: right;
    max-width: 32ch;
  }
  .more {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem var(--space-4);
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--size-ui);
  }
  .more a {
    color: var(--ink);
  }

  @media (max-width: 520px) {
    /* Phones: one honour per line, no dividers to strand at a wrap. */
    .honours__list {
      flex-direction: column;
    }
    .honours__item {
      padding-inline: 0;
      border-left: 0;
      white-space: normal;
    }
    .strip {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .strip__cell:nth-child(n) {
      border-left: 1px solid var(--line-soft);
      padding-left: var(--space-2);
      border-top: 0;
    }
    .strip__cell:nth-child(2n + 1) {
      border-left: 0;
      padding-left: 0;
    }
    .strip__cell:nth-child(n + 3) {
      border-top: 1px solid var(--line-soft);
    }
  }
  /* Tablet: three cells a row. Phones (≤520px, above) take two, so no label breaks inside a word. */
  @media (min-width: 521px) and (max-width: 899px) {
    .strip {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .strip__cell:nth-child(3n + 1) {
      border-left: 0;
      padding-left: 0;
    }
    .strip__cell:nth-child(n + 4) {
      border-top: 1px solid var(--line-soft);
    }
  }
  @media (max-width: 899px) {
    /* One column, in rank order: the leads first, then the narrower frames. */
    .led {
      grid-template-columns: minmax(0, 1fr);
    }
    .led__cell {
      grid-row: auto;
      grid-column: auto;
    }
    .led :global(.led__frame--lead > .frame__body) {
      padding-inline: var(--space-3);
    }
    .led :global(.led__frame--lead) .led__title {
      font-size: 1.35rem;
    }
    .co__row {
      grid-template-columns: 3ch minmax(0, 1fr);
    }
    .co__venue {
      grid-column: 2;
      text-align: left;
      max-width: none;
    }
    /* RoleMark is a child component; its class is unscoped. */
    .co :global(.co__role) {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>
