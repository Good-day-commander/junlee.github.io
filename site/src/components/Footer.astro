---
/*
  The ending every page shares (it replaces the round-2 Close): one STIX
  line, the link row in mono (LinkedIn, Google Scholar, ORCID), then the
  build date and the host. No Email (revision 2a): the sticky nav's Email
  is always on screen, so a page carries exactly one mailto link. No CV
  (PDF) (round 3b): the nav's CV is on screen in the same last viewport,
  and the PDF is one click on from there (the /cv/ action bar).

  Props, so no page shows a link twice in its last viewport:
  omit   labels to leave out of the row; /cv/ passes ['LinkedIn'], since
         its sticky bar carries LinkedIn in every viewport.
  links  false drops the row; home passes it, since the identity block
         already links LinkedIn, Google Scholar and ORCID.
  Hidden in print (the CV prints as a document).
*/
import { profile } from '@/data/content';
import { BUILD_DATE } from '@/lib/schema';

export interface Props {
  omit?: string[];
  links?: boolean;
}

const { omit = [], links: showLinks = true } = Astro.props;

const host = profile.links.site.replace(/^https?:\/\//, '');
const links = [
  { label: profile.email, href: `mailto:${profile.email}` },
  { label: 'LinkedIn', href: profile.links.linkedin },
  { label: 'Google Scholar', href: profile.links.scholar },
  { label: 'ORCID', href: profile.links.orcid },
].filter((l) => !omit.includes(l.label));
---

<footer class="footer">
  <div class="wrap footer__inner">
    <p class="footer__line">Open to collaboration, positions and paper requests.</p>
    {
      showLinks && links.length > 0 && (
        <ul class="footer__links t-mono">
          {links.map((l) => (
            <li>
              <a href={l.href} rel="me noopener">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
    <p class="footer__colophon t-mono">
      <span>Updated <time datetime={BUILD_DATE}>{BUILD_DATE}</time></span>
      <span>{host}</span>
    </p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--space-5);
    border-top: 1px solid var(--line);
    padding-block: var(--space-3) var(--space-4);
  }
  .footer__inner {
    display: grid;
    gap: var(--space-2);
    justify-items: start;
  }
  .footer__line {
    font-family: var(--font-text);
    font-size: 1.125rem;
    line-height: 1.45;
    color: var(--ink);
  }
  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
  }
  .footer__links a {
    display: inline-block;
    padding-block: 0.45rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: border-color var(--duration-quick) var(--ease-out);
  }
  .footer__links a:hover {
    border-bottom-color: var(--signal);
  }
  .footer__colophon {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
    color: var(--ink-3);
  }
  @media print {
    .footer {
      display: none;
    }
  }
</style>
