---
/*
  Site footer: a ruled colophon row. Every page now ends with the Close
  (components/Close.astro), which carries Email, CV (PDF), the address and
  Google Scholar / LinkedIn / ORCID directly above this row, so the footer
  does not print those links a second time. It holds the name and lab, the
  four pages and a way back to the top of a long page.
*/
import { profile } from '@/data/content';
import arrowUp from '@phosphor-icons/core/assets/regular/arrow-up.svg?raw';

const pages = [
  { href: '/research/', label: 'Research' },
  { href: '/publications/', label: 'Publications' },
  { href: '/record/', label: 'Record' },
  { href: '/cv/', label: 'CV' },
];

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__row">
    <p class="footer__colophon">
      <span class="num">©&nbsp;{year}</span>
      {profile.name}, {profile.lab}, {profile.university}
    </p>
    <nav class="footer__nav" aria-label="Footer">
      <ul>
        {
          pages.map((p) => (
            <li>
              <a class="footer__link" href={p.href}>
                {p.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="footer__link footer__top" href="#main">
            Top
            <span class="icon" aria-hidden="true" set:html={arrowUp} />
          </a>
        </li>
      </ul>
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: var(--space-3);
    color: var(--ink-2);
  }
  .footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
  }
  .footer__colophon {
    font-family: var(--font-ui);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--ink-3);
    text-wrap: pretty;
  }
  .footer__colophon .num {
    margin-right: 0.35rem;
  }
  .footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-3);
  }
  .footer__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.85rem;
    line-height: 1.2;
    color: var(--ink-2);
    text-decoration: none;
    padding-block: 0.6rem;
    border-bottom: 1px solid transparent;
    transition:
      color var(--duration-quick) var(--ease-out),
      border-color var(--duration-quick) var(--ease-out);
  }
  .footer__link:hover {
    color: var(--ink);
    border-bottom-color: var(--signal);
  }
  .icon {
    display: inline-flex;
    width: 1em;
    height: 1em;
    color: var(--ink-3);
  }
  .icon :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>
