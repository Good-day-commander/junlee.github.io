---
/*
  The ending every page shares: one STIX line inviting contact, the two
  actions (Email, the one signal-fill primary; CV (PDF), ghost), then the
  address and the three profile links in mono. Base.astro renders it at the
  end of <main> on every page, so no surface can end on a list; a page only
  passes its own line (and an optional note with one link).

  It is a <section>, so the last chapter or section before it drops its own
  bottom padding (:last-child / :last-of-type) and this band carries the one
  section-pad above the footer. Hidden in print.
*/
import Button from '@/components/Button.astro';
import { profile } from '@/data/content';
import envelope from '@phosphor-icons/core/assets/regular/envelope.svg?raw';
import filePdf from '@phosphor-icons/core/assets/regular/file-pdf.svg?raw';
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';

export interface Props {
  /** The invitation, one sentence. */
  line?: string;
  /** One supporting sentence under the line. */
  note?: string;
  /** Optional link appended to the note, e.g. to /cv/. */
  noteLink?: { href: string; label: string };
  id?: string;
}

const {
  line = 'Write to me about a collaboration, a position, or a copy of a paper.',
  note = 'Email is the fastest route; I reply from Seoul (UTC+9).',
  noteLink,
  id = 'contact',
} = Astro.props;

const profiles = [
  { label: 'Google Scholar', href: profile.links.scholar },
  { label: 'LinkedIn', href: profile.links.linkedin },
  { label: 'ORCID', href: profile.links.orcid },
];
---

<section class="close" id={id} aria-labelledby={`${id}-line`}>
  <div class="wrap close__inner">
    <div class="close__text">
      <h2 id={`${id}-line`} class="close__line">{line}</h2>
      <p class="close__note">
        {note}
        {
          noteLink && (
            <>
              {' '}
              <a href={noteLink.href}>{noteLink.label}</a>
            </>
          )
        }
      </p>
    </div>
    <div class="close__act">
      <div class="close__buttons">
        <Button href={`mailto:${profile.email}`}>
          Email
          <span slot="icon" aria-hidden="true" set:html={envelope} />
        </Button>
        <Button variant="ghost" href="/uploads/resume.pdf" external>
          CV (PDF)
          <span slot="icon" aria-hidden="true" set:html={filePdf} />
        </Button>
      </div>
      <ul class="close__links t-mono">
        <li>
          <a href={`mailto:${profile.email}`}>{profile.email}</a>
        </li>
        {
          profiles.map((l) => (
            <li>
              <a href={l.href} rel="me noopener">
                {l.label}
                <span class="close__icon" aria-hidden="true" set:html={arrowUpRight} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .close {
    padding-block: var(--section-pad) var(--space-6);
  }
  .close__inner {
    display: grid;
    gap: var(--space-4) var(--space-6);
    align-items: end;
  }
  /* The rule sits on the content edge, not full-bleed: the footer owns the full-width rule. */
  .close__inner::before {
    content: '';
    grid-column: 1 / -1;
    border-top: 1px solid var(--line);
    margin-bottom: var(--space-2);
  }
  @media (min-width: 900px) {
    .close__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 32rem);
    }
  }
  .close__text {
    display: grid;
    gap: var(--space-2);
  }
  .close__line {
    font-family: var(--font-text);
    font-weight: 400;
    font-size: clamp(1.5rem, 1.2rem + 1.2vw, 2.125rem);
    line-height: 1.3;
    letter-spacing: -0.005em;
    max-width: 30ch;
    color: var(--ink);
    text-wrap: balance;
  }
  .close__note {
    font-family: var(--font-text);
    font-size: var(--size-prose);
    line-height: var(--leading-prose);
    max-width: var(--measure);
    color: var(--ink-2);
    text-wrap: pretty;
  }
  .close__act {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }
  .close__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .close__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem var(--space-3);
    color: var(--ink-2);
  }
  .close__links a {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding-block: 0.35rem;
    color: var(--ink);
    text-decoration-color: var(--line);
  }
  .close__links a:hover {
    text-decoration-color: var(--signal);
  }
  .close__icon {
    display: inline-flex;
    width: 0.95em;
    height: 0.95em;
    color: var(--ink-3);
    transition: color var(--duration-quick) var(--ease-out);
  }
  .close__icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .close__links a:hover .close__icon {
    color: var(--signal);
  }
  @media print {
    .close {
      display: none;
    }
  }
</style>
