---
/*
  /record: talks, patents, funded projects, awards. A Read surface: rules
  and spacing carry the structure. Talks are split into the ones I presented
  and the ones I co-authored; registered versus pending and international
  versus domestic are marked on every row, straight from content.ts. Tags
  follow the title and venue on every width, never above a title.

  The talks open with three photographs as evidence of the talks they
  document (optimized by astro:assets from src/assets/photos). The
  registered patent families are featured as frames above the pending
  filings. Education, appointments and skills live on /cv only; the page
  ends with the shared Close (rendered by Base), which points there.
*/
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import Frame from '@/components/Frame.astro';
import PageHead from '@/components/record/PageHead.astro';
import Tag from '@/components/record/Tag.astro';
import { awards, fellowships, profile, talks, teaching, type Talk } from '@/data/content';
import {
  applicationLabel,
  awardPublication,
  capitalize,
  honourCounts,
  normRange,
  patentCounts,
  patentFamilies,
  period,
  projectSpan,
  projectsByEnd,
  talkCounts,
  talksByYear,
} from '@/components/record/records';
import { numberWord, numberWordCap } from '@/lib/format';
import photoAcfm from '@/assets/photos/gallery-acfm-2025.jpg';
import photoDmd from '@/assets/photos/gallery-dmd-2026.jpg';
import photoYonsei from '@/assets/photos/gallery-talk-yonsei.jpg';

const presentedYears = talksByYear('presenter');
const coauthoredYears = talksByYear('co-author');
const coauthoredCount = talkCounts.total - talkCounts.presented;
const families = patentFamilies();
const registeredFamilies = families.filter((f) => f.registered);
const pendingFamilies = families.filter((f) => !f.registered);

const lede = `${numberWordCap(talkCounts.total)} conference presentations (${numberWord(talkCounts.presented)} presented in person), ${numberWord(patentCounts.filings)} patent filings in ${numberWord(patentCounts.families)} families with ${numberWord(patentCounts.registered)} registered, ${numberWord(projectSpan.count)} funded projects from ${projectSpan.from} to ${projectSpan.to}, and the honours behind them.`;

const anchors = [
  { href: '#talks', label: 'Talks' },
  { href: '#patents', label: 'Patents' },
  { href: '#projects', label: 'Projects' },
  { href: '#awards', label: 'Awards' },
];

const talksLede = `${numberWordCap(talkCounts.presented)} I presented myself and ${numberWord(coauthoredCount)} as co-author; ${numberWord(talkCounts.international)} international, ${numberWord(talkCounts.domestic)} domestic.`;
const patentsLede = `${numberWordCap(patentCounts.filings)} filings, ${patentCounts.byJurisdiction
  .filter((j) => j.count > 0)
  .map((j) => `${numberWord(j.count)} ${j.jurisdiction}`)
  .join(', ')}. Counterpart filings share a row; the registered families come first.`;
const projectsLede = `Participating researcher on ${numberWord(projectSpan.count)} funded projects, ${projectSpan.from} to ${projectSpan.to}, newest end date first.`;
const awardsLede = `${numberWordCap(honourCounts.awards)} awards, ${numberWord(honourCounts.fellowships)} fellowships and ${numberWord(honourCounts.teaching)} teaching appointment.`;

/** "Seoul, Korea. Oral." The CV's lowercase format field, set in sentence case. */
const talkMeta = (t: Talk) => `${t.venue}, ${t.location}. ${capitalize(t.format)}.`;

/*
  Talk photographs. Two document talks in the record, and their captions are
  read from those rows; the Yonsei symposium has no CV entry, so its caption
  is the old site's gallery copy.
*/
const talkById = (id: string) => talks.find((t) => t.id === id);
const acronym = (venue: string) => venue.match(/\(([A-Z][A-Za-z0-9]+)\)/)?.[1];
function talkCaption(t: Talk | undefined, fallback: string): { text: string; href?: string } {
  if (!t) return { text: fallback };
  const a = acronym(t.venue);
  const name = a ? (a.includes(t.year) ? a.replace(t.year, ` ${t.year}`) : `${a} ${t.year}`) : `${t.venue} ${t.year}`;
  return { text: `${name}, ${t.location.split(',')[0]} · ${capitalize(t.format)}`, href: `#${t.id}` };
}
const I3 = talkById('I3');
const I1 = talkById('I1');
const photos = [
  {
    src: photoAcfm,
    alt: I3
      ? `${profile.name} presenting at the podium of the ${I3.venue}, ${I3.location}.`
      : `${profile.name} at a conference podium.`,
    caption: talkCaption(I3, 'ACFM 2025, Seoul'),
  },
  {
    src: photoDmd,
    alt: I1 ? `The poster presented at the ${I1.venue}: ${I1.title}.` : 'Conference poster.',
    caption: talkCaption(I1, 'DMD 2026, Minneapolis'),
  },
  {
    src: photoYonsei,
    alt: `${profile.name} presenting cardiovascular AI research at a Yonsei department symposium.`,
    caption: { text: 'Yonsei department symposium, 2024' } as { text: string; href?: string },
  },
];

const description = `Talks, patents, funded projects and awards of ${profile.name}, with presenter, registered and pending stated on every row.`;
---

<Base
  title="Record"
  description={description}
  surface="box"
  ogImage="/og/record.png"
  ogAlt={`${profile.name}, Record: the page heading on light-box white with its lede, "${lede}"`}
  close={{
    line: 'Write to me about any of this work, a position, or a copy of a paper.',
    note: 'Education, appointments and skills are on the CV.',
    noteLink: { href: '/cv/', label: 'Read the CV' },
  }}
>
  <PageHead heading="Record" lede={lede} anchors={anchors} />

  <Section heading="Talks" id="talks" lede={talksLede} class="rec">
    <ul class="photos">
      {
        photos.map((ph) => (
          <li class="photo" style={`--a: ${(ph.src.width / ph.src.height).toFixed(4)};`}>
            <figure class="photo__plate">
              <Image
                src={ph.src}
                alt={ph.alt}
                width={960}
                widths={[320, 480, 720, 960]}
                sizes="(min-width: 1024px) 26rem, (min-width: 600px) 45vw, 90vw"
                format="webp"
                quality={78}
                loading="lazy"
                class="photo__img"
              />
              <figcaption class="photo__caption t-mono">
                {ph.caption.href ? <a href={ph.caption.href}>{ph.caption.text}</a> : ph.caption.text}
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
    {
      [
        { heading: 'Presented', groups: presentedYears, co: false },
        { heading: 'Co-authored', groups: coauthoredYears, co: true },
      ].map((block) => (
        <div class="sub">
          <h3 class="sub__heading t-subheading">{block.heading}</h3>
          <div class="years">
            {block.groups.map((group) => (
              <div class="year">
                <h4 class="year__label t-mono">{group.year}</h4>
                <ol class="rows">
                  {group.items.map((talk) => (
                    <li class:list={['row row--talk', { 'row--co': block.co }]} id={talk.id}>
                      <div class="row__main">
                        <p class="row__title">{talk.title}</p>
                        <p class="row__meta">
                          {talkMeta(talk)} <span class="row__note">{talk.note}</span>
                        </p>
                      </div>
                      <div class="row__tags">
                        <Tag tone="soft" title={talk.category}>
                          {talk.category === 'International' ? 'Intl' : 'Domestic'}
                        </Tag>
                      </div>
                    </li>
                  ))}
                </ol>
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </Section>

  <Section heading="Patents" id="patents" lede={patentsLede} class="rec">
    {
      registeredFamilies.length > 0 && (
        <ul class="registered">
          {registeredFamilies.map((family) => (
            <li id={family.key}>
              <Frame
                as="article"
                padded
                class="registered__frame"
                tl={family.jurisdictions.join(' · ')}
                tr={family.yearLabel}
              >
                <h3 class="frame__what registered__title">{family.title}</h3>
                <ul class="filings">
                  {family.members.map((p) => (
                    <li class="filing" id={p.id !== family.key ? p.id : undefined}>
                      <span class="filing__app t-mono">{applicationLabel(p)}</span>
                      {p.status === 'registered' && p.registrationNo ? (
                        <span class="filing__reg t-mono">
                          <span>
                            Registered No. {p.registrationNo}
                            {p.registrationDate && <span class="filing__date"> · {p.registrationDate}</span>}
                          </span>
                          <Tag tone="signal">Registered</Tag>
                        </span>
                      ) : (
                        <span class="filing__pending t-mono">filed {p.year} · pending</span>
                      )}
                    </li>
                  ))}
                </ul>
                <p class="row__meta row__meta--inventors">{family.members[0].inventors}</p>
              </Frame>
            </li>
          ))}
        </ul>
      )
    }
    <ol class="rows rows--ruled">
      {
        pendingFamilies.map((family) => (
          <li class="row row--patent" id={family.key}>
            <div class="row__main">
              <p class="row__title">{family.title}</p>
              <ul class="filings">
                {family.members.map((p) => (
                  <li class="filing" id={p.id !== family.key ? p.id : undefined}>
                    <span class="filing__app t-mono">{applicationLabel(p)}</span>
                    <span class="filing__pending t-mono">filed {p.year} · pending</span>
                  </li>
                ))}
              </ul>
              <p class="row__meta row__meta--inventors">{family.members[0].inventors}</p>
            </div>
            <div class="row__tags">
              {family.jurisdictions.map((j) => (
                <Tag tone="soft">{j}</Tag>
              ))}
              <span class="row__year t-mono">{family.yearLabel}</span>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section heading="Projects" id="projects" lede={projectsLede} class="rec">
    <ol class="rows rows--ruled">
      {
        projectsByEnd.map((project) => (
          <li class="row row--project" id={project.id}>
            <p class="row__period t-mono">{period(project.start, project.end)}</p>
            <div class="row__main">
              <p class="row__title">{project.title}</p>
              <p class="row__meta">{project.program ? `${project.funder}, ${project.program}` : project.funder}</p>
              <p class="row__grant t-mono">{project.grantNo}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section heading="Awards and fellowships" id="awards" lede={awardsLede} class="rec">
    <div class="sub">
      <h3 class="sub__heading t-subheading">Awards</h3>
      <ol class="rows rows--ruled">
        {
          awards.map((award) => {
            const pub = awardPublication(award.forPublication);
            return (
              <li class="row row--honour">
                <p class="row__period t-mono">{award.year}</p>
                <div class="row__main">
                  <p class="row__title">{award.title}</p>
                  <p class="row__meta">
                    {award.note ? `${award.org}, ${award.note}` : award.org}
                    {pub && (
                      <span>
                        {' '}
                        (<a href={`/publications/#${pub.id}`}>{pub.id}</a>)
                      </span>
                    )}
                  </p>
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
    <div class="sub">
      <h3 class="sub__heading t-subheading">Fellowships</h3>
      <ol class="rows rows--ruled">
        {
          fellowships.map((f) => (
            <li class="row row--honour">
              <p class="row__period t-mono">{normRange(f.period)}</p>
              <div class="row__main">
                <p class="row__title">{f.title}</p>
                <p class="row__meta">{f.org}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="sub">
      <h3 class="sub__heading t-subheading">Teaching</h3>
      <ol class="rows rows--ruled">
        {
          teaching.map((t) => (
            <li class="row row--honour">
              <p class="row__period t-mono">{normRange(t.period)}</p>
              <div class="row__main">
                <p class="row__title">{t.role}</p>
                <p class="row__meta">{t.org}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>
</Base>

<style>
  /*
    Talk photographs: each plate grows in proportion to its aspect ratio
    (--a), so the plates on one row share one height without cropping.
  */
  .photos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    max-width: 60rem;
    margin-bottom: var(--space-5);
  }
  .photo {
    flex: var(--a) 1 calc(var(--a) * 9rem);
    max-width: calc(var(--a) * 16rem);
    min-width: 0;
  }
  .photo__plate {
    margin: 0;
    display: grid;
    gap: var(--space-1);
  }
  .photo :global(.photo__img) {
    width: 100%;
    height: auto;
    aspect-ratio: var(--a);
    object-fit: cover;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-1);
  }
  .photo__caption {
    font-size: var(--size-label);
    line-height: 1.4;
    color: var(--ink-2);
  }
  .photo__caption a {
    color: var(--ink-2);
    text-decoration-color: var(--line);
  }
  .photo__caption a:hover {
    color: var(--ink);
    text-decoration-color: var(--signal);
  }

  /* Year groups for talks */
  .years {
    display: grid;
    gap: var(--space-4);
  }
  .year {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--space-2) var(--space-3);
    border-top: 1px solid var(--line);
    padding-top: var(--space-2);
  }
  .year__label {
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    padding-top: 0.75rem;
  }

  /* Registered patent families: frames above the pending list. */
  .registered {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
    margin-bottom: var(--space-4);
  }
  .registered > li {
    min-width: 0;
  }
  .registered :global(.registered__frame) {
    height: 100%;
  }
  .registered :global(.registered__frame > .frame__body) {
    display: grid;
    gap: var(--space-2);
    align-content: start;
  }
  .registered__title {
    max-width: 40ch;
  }
  /* In a frame the number and its registration stack, so REGISTERED stays on the registration row. */
  .registered .filing {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.2rem;
  }
  .registered .filing + .filing {
    margin-top: 0.35rem;
  }
  .filing__reg {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
  }

  /* Generic ruled rows */
  .rows {
    display: grid;
  }
  .rows--ruled > .row {
    border-top: 1px solid var(--line);
  }
  .rows--ruled > .row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-2) var(--space-3);
  }
  .row--talk {
    padding-block: 0.75rem;
  }
  .row--talk + .row--talk {
    border-top: 1px solid var(--line-soft);
  }
  /* Talks I co-authored read one step quieter than the ones I gave. */
  .row--co .row__title {
    font-size: 1rem;
    font-weight: 500;
  }
  .row--co .row__meta {
    font-size: 0.95rem;
  }
  .row--project,
  .row--honour {
    grid-template-columns: 11rem minmax(0, 1fr);
  }
  .row__main {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }
  .row__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.35;
    letter-spacing: -0.005em;
    text-wrap: pretty;
    max-width: 62ch;
  }
  .row__meta {
    font-family: var(--font-text);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
    max-width: 66ch;
  }
  .row__meta--inventors {
    font-size: 0.95rem;
  }
  .row__note {
    color: var(--ink-3);
  }
  .row__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: start;
    gap: 0.35rem;
    justify-content: flex-end;
    padding-top: 0.2rem;
  }
  .row__year {
    color: var(--ink-3);
    margin-left: var(--space-1);
  }
  .row__period {
    color: var(--ink-2);
    padding-top: 0.3rem;
    white-space: nowrap;
  }
  .row__grant {
    color: var(--ink-3);
  }

  /* Patent filings */
  .filings {
    display: grid;
    gap: 0.35rem;
    margin-top: var(--space-1);
  }
  .filing {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15rem var(--space-2);
    align-items: baseline;
  }
  .filing__app {
    color: var(--ink);
    min-width: 12rem;
  }
  .filing__reg {
    color: var(--ink);
  }
  .filing__date,
  .filing__pending {
    color: var(--ink-3);
  }

  /* Sub-blocks inside a section */
  .sub + .sub {
    margin-top: var(--space-5);
  }
  .sub__heading {
    margin-bottom: var(--space-2);
  }

  @media (max-width: 760px) {
    .year {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .year__label {
      padding-top: 0;
    }
    .row,
    .row--project,
    .row--honour {
      grid-template-columns: 1fr;
    }
    .registered {
      grid-template-columns: minmax(0, 1fr);
    }
    .row__tags {
      justify-content: flex-start;
      padding-top: 0;
    }
    .row__period {
      padding-top: 0;
    }
    .filing__app {
      min-width: 0;
    }
  }
</style>
