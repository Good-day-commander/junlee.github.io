---
/*
  /record: talks, patents, funded projects, awards, background. A Read
  surface: rules and spacing carry the structure, no cards. Presenter versus
  co-author, registered versus pending and international versus domestic are
  marked on every row, straight from content.ts.
*/
import Base from '@/layouts/Base.astro';
import Section from '@/components/Section.astro';
import PageHead from '@/components/record/PageHead.astro';
import Tag from '@/components/record/Tag.astro';
import { awards, education, experience, fellowships, profile, skills, teaching } from '@/data/content';
import {
  applicationLabel,
  awardPublication,
  honourCounts,
  patentCounts,
  patentFamilies,
  period,
  projectSpan,
  projectsByEnd,
  talkCounts,
  talksByYear,
} from '@/components/record/records';
import { numberWord, numberWordCap } from '@/lib/format';

const years = talksByYear();
const families = patentFamilies();

const lede = `${numberWordCap(talkCounts.total)} conference presentations (${numberWord(talkCounts.presented)} presented in person), ${numberWord(patentCounts.filings)} patent filings in ${numberWord(patentCounts.families)} families with ${numberWord(patentCounts.registered)} registered, ${numberWord(projectSpan.count)} funded projects from ${projectSpan.from} to ${projectSpan.to}, and the honours, appointments and training behind them.`;

const anchors = [
  { href: '#talks', label: 'Talks' },
  { href: '#patents', label: 'Patents' },
  { href: '#projects', label: 'Projects' },
  { href: '#awards', label: 'Awards' },
  { href: '#background', label: 'Background' },
];

const talksLede = `${numberWordCap(talkCounts.international)} international and ${numberWord(talkCounts.domestic)} domestic. Presenter marks the talks he gave himself.`;
const patentsLede = `${numberWordCap(patentCounts.filings)} filings, ${patentCounts.byJurisdiction
  .filter((j) => j.count > 0)
  .map((j) => `${numberWord(j.count)} ${j.jurisdiction}`)
  .join(', ')}. Counterpart filings share a row; registered families come first.`;
const projectsLede = `Participating researcher on ${numberWord(projectSpan.count)} funded projects, ${projectSpan.from} to ${projectSpan.to}, newest end date first.`;
const awardsLede = `${numberWordCap(honourCounts.awards)} awards, ${numberWord(honourCounts.fellowships)} fellowships and ${numberWord(honourCounts.teaching)} teaching appointment.`;

const skillGroups: { label: string; items: string[] }[] = [
  { label: 'Computational', items: skills.computational },
  { label: 'Machine learning', items: skills.ml },
  { label: 'Data', items: skills.data },
  { label: 'Languages', items: skills.languages },
];

const description = `Talks, patents, funded projects, awards and background of ${profile.name}, with presenter, registered and pending stated on every row.`;
---

<Base title="Record" description={description} surface="box">
  <PageHead heading="Record" lede={lede} anchors={anchors} />

  <Section heading="Talks" id="talks" lede={talksLede} class="rec">
    <div class="years">
      {
        years.map((group) => (
          <div class="year">
            <h3 class="year__label t-mono">{group.year}</h3>
            <ol class="rows">
              {group.items.map((talk) => (
                <li class="row row--talk" id={talk.id}>
                  <div class="row__main">
                    <p class="row__title">{talk.title}</p>
                    <p class="row__meta">
                      {talk.venue}, {talk.location}. <span class="row__format">{talk.format}</span>.{' '}
                      <span class="row__note">{talk.note}</span>
                    </p>
                  </div>
                  <div class="row__tags">
                    <Tag tone={talk.role === 'presenter' ? 'signal' : 'soft'}>
                      {talk.role === 'presenter' ? 'Presenter' : 'Co-author'}
                    </Tag>
                    <Tag tone="soft" title={talk.category}>
                      {talk.category === 'International' ? 'Intl' : 'Domestic'}
                    </Tag>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>
  </Section>

  <Section heading="Patents" id="patents" lede={patentsLede} class="rec">
    <ol class="rows rows--ruled">
      {
        families.map((family) => (
          <li class="row row--patent" id={family.key}>
            <div class="row__main">
              <p class="row__title">{family.title}</p>
              <ul class="filings">
                {family.members.map((p) => (
                  <li class="filing" id={p.id !== family.key ? p.id : undefined}>
                    <span class="filing__app t-mono">{applicationLabel(p)}</span>
                    {p.status === 'registered' && p.registrationNo ? (
                      <span class="filing__reg t-mono">
                        Registered No. {p.registrationNo}
                        {p.registrationDate && <span class="filing__date"> · {p.registrationDate}</span>}
                      </span>
                    ) : (
                      <span class="filing__pending t-mono">filed {p.year} · pending</span>
                    )}
                  </li>
                ))}
              </ul>
              <p class="row__meta row__meta--inventors">{family.members[0].inventors}</p>
            </div>
            <div class="row__tags">
              {family.registered && <Tag tone="signal">Registered</Tag>}
              {family.jurisdictions.map((j) => (
                <Tag tone="soft">{j}</Tag>
              ))}
              <span class="row__year t-mono">{family.yearLabel}</span>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section heading="Projects" id="projects" lede={projectsLede} class="rec">
    <ol class="rows rows--ruled">
      {
        projectsByEnd.map((project) => (
          <li class="row row--project" id={project.id}>
            <p class="row__period t-mono">{period(project.start, project.end)}</p>
            <div class="row__main">
              <p class="row__title">{project.title}</p>
              <p class="row__meta">{project.program ? `${project.funder}, ${project.program}` : project.funder}</p>
              <p class="row__grant t-mono">{project.grantNo}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </Section>

  <Section heading="Awards and fellowships" id="awards" lede={awardsLede} class="rec">
    <div class="sub">
      <h3 class="sub__heading t-subheading">Awards</h3>
      <ol class="rows rows--ruled">
        {
          awards.map((award) => {
            const pub = awardPublication(award.forPublication);
            return (
              <li class="row row--honour">
                <p class="row__period t-mono">{award.year}</p>
                <div class="row__main">
                  <p class="row__title">{award.title}</p>
                  <p class="row__meta">
                    {award.note ? `${award.org}, ${award.note}` : award.org}{pub && <span> (<a href={`/publications#${pub.id}`}>{pub.id}</a>)</span>}
                  </p>
                </div>
              </li>
            );
          })
        }
      </ol>
    </div>
    <div class="sub">
      <h3 class="sub__heading t-subheading">Fellowships</h3>
      <ol class="rows rows--ruled">
        {
          fellowships.map((f) => (
            <li class="row row--honour">
              <p class="row__period t-mono">{f.period}</p>
              <div class="row__main">
                <p class="row__title">{f.title}</p>
                <p class="row__meta">{f.org}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="sub">
      <h3 class="sub__heading t-subheading">Teaching</h3>
      <ol class="rows rows--ruled">
        {
          teaching.map((t) => (
            <li class="row row--honour">
              <p class="row__period t-mono">{t.period}</p>
              <div class="row__main">
                <p class="row__title">{t.role}</p>
                <p class="row__meta">{t.org}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </Section>

  <Section heading="Background" id="background" class="rec">
    <div class="sub">
      <h3 class="sub__heading t-subheading">Education</h3>
      <ol class="rows rows--ruled">
        {
          education.map((e) => (
            <li class="row row--bg">
              <p class="row__period t-mono">{period(e.start, e.end)}</p>
              <div class="row__main">
                <p class="row__title">{e.degree}</p>
                <p class="row__meta">
                  {e.institution}, {e.location}
                </p>
                {e.note && <p class="row__meta row__meta--note">{e.note}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="sub">
      <h3 class="sub__heading t-subheading">Experience</h3>
      <ol class="rows rows--ruled">
        {
          experience.map((x) => (
            <li class="row row--bg">
              <p class="row__period t-mono">{period(x.start, x.end)}</p>
              <div class="row__main">
                <p class="row__title">{x.role}</p>
                <p class="row__meta">
                  {x.org}, {x.location}
                </p>
                {x.notes && (
                  <ul class="notes">
                    {x.notes.map((n) => (
                      <li class="row__meta row__meta--note">{n}</li>
                    ))}
                  </ul>
                )}
                <ul class="bullets">
                  {x.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <div class="sub">
      <h3 class="sub__heading t-subheading">Skills</h3>
      <dl class="skills">
        {
          skillGroups.map((g) => (
            <div class="skills__group">
              <dt>{g.label}</dt>
              <dd>{g.items.join('; ')}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>
</Base>

<style>
  :global(.page-head + .section.section) {
    padding-top: var(--space-6);
  }
  :global(.section.rec) {
    scroll-margin-top: var(--space-2);
  }

  /* Year groups for talks */
  .years {
    display: grid;
    gap: var(--space-4);
  }
  .year {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: var(--space-2) var(--space-3);
    border-top: 1px solid var(--line);
    padding-top: var(--space-2);
  }
  .year__label {
    font-size: 1rem;
    font-weight: 500;
    color: var(--ink);
    padding-top: 0.75rem;
  }

  /* Generic ruled rows */
  .rows {
    display: grid;
  }
  .rows--ruled > .row {
    border-top: 1px solid var(--line);
  }
  .rows--ruled > .row:last-child {
    border-bottom: 1px solid var(--line);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--space-1) var(--space-3);
    padding-block: var(--space-2) var(--space-3);
    scroll-margin-top: var(--space-2);
  }
  .row--talk {
    padding-block: 0.75rem;
  }
  .row--talk + .row--talk {
    border-top: 1px solid var(--line-soft);
  }
  .row--project,
  .row--honour,
  .row--bg {
    grid-template-columns: 11rem minmax(0, 1fr);
  }
  .row__main {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }
  .row__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.0625rem;
    line-height: 1.35;
    letter-spacing: -0.005em;
    text-wrap: pretty;
    max-width: 62ch;
  }
  .row__meta {
    font-family: var(--font-text);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
    max-width: 66ch;
  }
  .row__meta--note {
    font-style: italic;
  }
  .row__meta--inventors {
    font-size: 0.95rem;
  }
  .row__format {
    color: var(--ink-2);
  }
  .row__note {
    color: var(--ink-3);
  }
  .row__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-content: start;
    gap: 0.35rem;
    justify-content: flex-end;
    padding-top: 0.2rem;
  }
  .row__year {
    color: var(--ink-3);
    margin-left: 0.25rem;
  }
  .row__period {
    color: var(--ink-2);
    padding-top: 0.3rem;
    white-space: nowrap;
  }
  .row__grant {
    color: var(--ink-3);
  }

  /* Patent filings */
  .filings {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.25rem;
  }
  .filing {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem var(--space-2);
    align-items: baseline;
  }
  .filing__app {
    color: var(--ink);
    min-width: 12rem;
  }
  .filing__reg {
    color: var(--ink);
  }
  .filing__date,
  .filing__pending {
    color: var(--ink-3);
  }

  /* Sub-blocks inside a section */
  .sub + .sub {
    margin-top: var(--space-5);
  }
  .sub__heading {
    margin-bottom: var(--space-2);
  }
  .notes {
    display: grid;
    gap: 0.15rem;
  }
  .bullets {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.35rem;
    padding-left: 1.1rem;
    list-style: disc;
    font-family: var(--font-text);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 66ch;
  }
  .bullets li::marker {
    color: var(--ink-3);
  }
  .skills {
    display: grid;
    gap: var(--space-2);
    border-top: 1px solid var(--line);
    padding-top: var(--space-2);
  }
  .skills__group {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: var(--space-3);
  }
  .skills dt {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--size-ui);
    color: var(--ink);
  }
  .skills dd {
    margin: 0;
    font-family: var(--font-text);
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink-2);
    max-width: 66ch;
  }

  @media (max-width: 760px) {
    .year {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .year__label {
      padding-top: 0;
    }
    .row,
    .row--project,
    .row--honour,
    .row--bg,
    .skills__group {
      grid-template-columns: 1fr;
    }
    .row__tags {
      justify-content: flex-start;
      order: -1;
      padding-top: 0;
    }
    .row__period {
      padding-top: 0;
    }
    .filing__app {
      min-width: 0;
    }
  }
</style>
