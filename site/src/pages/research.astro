---
/*
  /research: every research project, project by project as the owner did
  them (2026-10-19), not grouped into the home's four fields. A flat list,
  newest first (lib/schema.ts researchEntries orders it): each project is a
  header row (title, years), one sentence and its outputs line, every output
  a link to its CV row. A⁺4DCT carries its results plate
  (components/research/A4dctResults.astro) and two older projects a paper
  figure linked full size. The three live demos sit inside the projects they
  belong to (PINO, 4D CT, fluid bolus), each with its method and metrics
  folded into one row that ships closed at every width (the outputs line
  already links the paper into the CV, so there is no citation line).
  PINO keeps two plates in view, the viewer and its Pd/Pa curve under it
  (the curve is the FFR evidence a reader scans for); 4D CT and fluid bolus
  show one, and the CWT scalogram folds into the bolus row. Each keeps its
  old anchor (#flow, #image, #pulse). The page head is the h1 only. Budget
  (checked by the build): 1000 visible words in <main>, 260 per project.

  Every number is computed from content.ts or the PINO / pulse / image
  manifests through lib/schema.ts and components/research/data.ts, the
  same sources as /research.md.
*/
import Base from '@/layouts/Base.astro';
import Frame from '@/components/Frame.astro';
import Project from '@/components/research/Project.astro';
import A4dctResults from '@/components/research/A4dctResults.astro';
import MetricsTable from '@/components/research/MetricsTable.astro';
import CwtStrip from '@/components/research/CwtStrip.astro';
import VesselViewer from '@/islands/VesselViewer';
import FfrCurve from '@/islands/FfrCurve';
import SpectrogramDevelop from '@/islands/SpectrogramDevelop';
import { rasterAxes } from '@/islands/pulse/raster';
import PhaseScrubber from '@/islands/PhaseScrubber';
import { imageManifest, imageManifestUrl } from '@/islands/image/data';
import { profile } from '@/data/content';
import { formatDecimal, formatSeconds } from '@/lib/format';
import { pino, pulse, urls } from '@/components/research/data';
import replayIcon from '@phosphor-icons/core/assets/regular/arrow-counter-clockwise.svg?raw';
import caretDown from '@phosphor-icons/core/assets/regular/caret-down.svg?raw';
import Button from '@/components/Button.astro';
import { flow, image, pulseFacts, researchEntries, LEGACY_ANCHORS } from '@/lib/schema';

const c = pino.metrics.case;
const im = imageManifest;
/* Spectrogram axes at build time (the STFT shows its recommended crop), so the ticks and dB range are in the server HTML. */
const stftAxes = rasterAxes(pulse.stft, pulse.stft.recommended_crop_hz);

const description = `${profile.name}'s research, project by project, newest first: a neural operator returning a pressure field in ${flow.inference}, 4D CT for time-resolved FFR, smartwatch PPG for fluid-bolus prediction.`;
---

<Base
  title="Research"
  description={description}
  ogImage="/og/research.png"
  ogAlt={`${profile.name}, Research: the page heading over the film ground`}
>
  <header class="r-head wrap">
    <h1 class="r-head__title">Research</h1>
  </header>

  {
    researchEntries.map((entry) =>
      entry.demo === 'flow' ? (
        <Project entry={entry} anchor={LEGACY_ANCHORS.flow}>
          <div class="art-grid">
            <figure class="art">
              <Frame plate class="art__frame art__frame--viewer">
                <VesselViewer client:visible manifestUrl={urls.pinoManifest} mode="chapter" />
              </Frame>
              <figcaption class="art__caption">
                <span class="art__caption-wide">CFD left, PINO right. </span>Pressure R² <span class="num">{formatDecimal(c.pressure_Pa.R2, 3)}</span>.
              </figcaption>
            </figure>
            <figure class="art">
              <Frame plate class="art__frame art__frame--curve">
                <FfrCurve client:visible centerlineUrl={urls.centerline} mode="chapter" />
              </Frame>
              <figcaption class="art__caption">
                CFD and PINO differ by <span class="num">{flow.ffrDelta}</span> at the distal probe.
              </figcaption>
            </figure>
          </div>

          <details class="more">
            <summary class="more__summary">
              <span class="more__label">Method and metrics</span>
              <span class="more__chevron" aria-hidden="true" set:html={caretDown} />
            </summary>
            <p class="t-prose">
              A geometry-informed neural operator returns pressure and velocity at all {flow.volumeNodes} volume nodes from the
              vessel surface alone, with a Navier–Stokes residual in its loss. Every case is predicted by a model that never saw it.
            </p>

            <MetricsTable
              id="flow-metrics"
              label="PINO metrics, this case against the cohort"
              caption={`${flow.label.replace(/^./, (s) => s.toUpperCase())}. This case ranks ${flow.rank} by pressure R².`}
              head={['Metric', 'This case', `Cohort median, n = ${flow.cohortN}`]}
              rows={flow.rows}
            />

          </details>
        </Project>
      ) : entry.demo === 'image' ? (
        <Project entry={entry} anchor={LEGACY_ANCHORS.image}>
          <figure class="art">
            <Frame plate class="art__frame">
              <PhaseScrubber client:visible manifestUrl={imageManifestUrl} manifest={im} />
            </Frame>
            <figcaption class="art__caption">
              One cardiac cycle: {image.acquiredList} acquired by CT, the other {image.synthesized} synthesized.
            </figcaption>
          </figure>

          <details class="more">
            <summary class="more__summary">
              <span class="more__label">Method and metrics</span>
              <span class="more__chevron" aria-hidden="true" set:html={caretDown} />
            </summary>
            <p class="t-prose">
              A diffusion deformable model synthesizes the full cardiac cycle from two acquired CT phases. Each phase is meshed
              and solved, so FFR is followed across the cycle instead of read from one still.
            </p>

            <MetricsTable
              id="image-metrics"
              label="4D CT synthesis and CT-FFR metrics reported in the paper"
              caption={`Reported in the 4D CT paper.`}
              head={['Metric', 'Value']}
              rows={[
                ['4D CT-FFR accuracy against invasive FFR', `${image.ffrAccuracy} %`],
                ['Synthesis PSNR', image.psnr],
                ['Synthesis SSIM', image.ssim],
                ['Synthesis Dice', image.dice],
              ]}
            />

          </details>
        </Project>
      ) : entry.demo === 'pulse' ? (
        <Project entry={entry} anchor={LEGACY_ANCHORS.pulse}>
          <figure class="art">
            <Frame plate class="art__frame art__frame--stft">
              <SpectrogramDevelop
                recordingS={pulseFacts.durationS}
                client:visible
                manifestUrl={urls.pulseManifest}
                variant="stft"
                axes={stftAxes}
                replayGroup="pulse"
                bare
              />
            </Frame>
            <figcaption class="art__caption">
              One <span class="num">{formatSeconds(pulseFacts.durationS, 0)}</span> recording before the first bolus; the bright band is the heartbeat.
            </figcaption>
          </figure>
          <!-- One Replay for both plates (the CWT strip sits inside Method and metrics); shown once the islands can hear it (hidden without JS). -->
          <div class="pulse-replay" data-replay-group="pulse" hidden>
            <Button variant="ghost" size="compact" aria-label="Replay both spectrograms">
              Replay
              <span slot="icon" aria-hidden="true" set:html={replayIcon} />
            </Button>
          </div>

          <details class="more">
            <summary class="more__summary">
              <span class="more__label">Method and metrics</span>
              <span class="more__chevron" aria-hidden="true" set:html={caretDown} />
            </summary>
            <p class="t-prose">
              Smartwatch PPG is filtered, cut into overlapping segments and turned into STFT and CWT images; the
              {pulseFacts.networks} CNNs score each segment and the scores are pooled per patient.
            </p>

            <CwtStrip />

            <MetricsTable
              id="pulse-metrics"
              label="Fluid-bolus prediction at patient level"
              caption={`Weights and cutoff were chosen on the development set; the temporal set was scored unchanged.`}
              head={['Set', 'AUC [95 % CI]', 'n']}
              rows={[
                ['Development, out-of-fold', `${pulseFacts.devAuc} [${pulseFacts.devCi}]`, pulseFacts.devN],
                ['Same-center temporal set', `${pulseFacts.tempAuc} [${pulseFacts.tempCi}]`, pulseFacts.tempN],
              ]}
            />

          </details>
        </Project>
      ) : entry.results ? (
        <Project entry={entry}>
          <A4dctResults results={entry.results} />
        </Project>
      ) : entry.figure ? (
        <Project entry={entry}>
          <a class="paper-figure" href={entry.figure.src} target="_blank" rel="noopener" aria-label={`View full figure: ${entry.figure.alt}`}>
            <figure class="art">
              <img class="paper-figure__image plate" src={entry.figure.src} width={entry.figure.width} height={entry.figure.height} alt={entry.figure.alt} loading="lazy" decoding="async" />
              <figcaption class="art__caption">{entry.figure.caption} <span class="paper-figure__open">View full figure</span></figcaption>
            </figure>
          </a>
        </Project>
      ) : (
        <Project entry={entry} />
      ),
    )
  }
  <script is:inline>
    /* Phones: each outputs line shows its first item and a +N control that shows the rest in place. The markup ships whole with the control hidden, so wide screens, agents and no-JS readers see every item. */
    if (window.matchMedia('(max-width: 640px)').matches) {
      document.querySelectorAll('.project__more').forEach((button) => {
        const line = button.closest('.project__outputs');
        line.setAttribute('data-collapsed', '');
        button.hidden = false;
        button.addEventListener('click', () => {
          const open = line.hasAttribute('data-collapsed');
          line.toggleAttribute('data-collapsed', !open);
          button.setAttribute('aria-expanded', String(open));
        });
      });
    }
  </script>
</Base>

<script>
  /* The fluid-bolus project's one Replay restarts both spectrogram plates (SpectrogramDevelop replayGroup); the CWT strip hydrates when idle, finished inside its closed Method and metrics row, so it hears the Replay whether or not the row is open. */
  for (const box of document.querySelectorAll<HTMLElement>('[data-replay-group]')) {
    const group = box.dataset.replayGroup;
    box.hidden = false;
    box.querySelector('button')?.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('spectrogram:replay', { detail: { group } }));
    });
  }
</script>

<style>
  .r-head {
    padding-block: var(--space-5) 0;
    display: grid;
    gap: var(--space-2);
  }
  .r-head__title {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 92;
    font-weight: 600;
    font-size: clamp(2.25rem, 1.6rem + 3vw, 4rem);
    line-height: 1;
    letter-spacing: -0.025em;
  }

  /*
    One plate per demo in view, except PINO, whose viewer and Pd/Pa curve
    stack in one grid at the column's width; the CWT scalogram sits inside
    Method and metrics. Each frame is a flex column whose body takes the slack.
  */
  .art-grid {
    display: grid;
    gap: var(--space-3);
    align-items: stretch;
  }
  .paper-figure {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .paper-figure__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 32rem;
    object-fit: contain;
    background: var(--bg);
    border: 1px solid var(--line);
  }
  .paper-figure__open {
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  :global(.art) {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--space-1);
    margin: 0;
    min-width: 0;
  }
  :global(.art) > :global(.art__frame) {
    display: flex;
    flex-direction: column;
  }
  :global(.art) > :global(.art__frame > .frame__body) {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  :global(.art) :global(.art__frame--curve > .frame__body) {
    padding-top: var(--space-2);
  }
  /* Spectrograms: the plot holds the top of the body and the toolbar its bottom. */
  :global(.art) :global(.art__frame--stft > .frame__body),
  :global(.art) :global(.art__frame--cwt > .frame__body) {
    justify-content: flex-start;
  }
  :global(.art) :global(.pulse--bare) {
    flex: 1 0 auto;
    align-content: space-between;
  }
  :global(.art) :global(.pulse__bar > .pulse__btn) {
    margin-left: auto;
  }
  .pulse-replay {
    margin-top: var(--space-2);
  }
  .pulse-replay[hidden] {
    display: none;
  }
  :global(.art__caption),
  :global(.art) :global(.art__caption) {
    font-family: var(--font-text);
    font-style: italic;
    font-size: var(--size-caption);
    line-height: 1.5;
    color: var(--ink-2);
    text-wrap: pretty;
  }
  /*
    "CFD left, PINO right" is true only beside the wipe handle. The viewer
    marks its control on its root (data-control, chosen by the frame's own
    width), so the caption follows the control, also on a viewport a little
    over 640px whose frame is under it. Phones hide the clause from the
    first paint, before the island hydrates; their frame always takes the toggle.
  */
  :global(.art:has([data-control][data-field='error']) .art__caption-wide),
  :global(.art:has([data-control='toggle']) .art__caption-wide) {
    display: none;
  }
  @media (max-width: 640px) {
    :global(.art__caption-wide) {
      display: none;
    }
  }
  /* Numbers inside a caption read in the caption's own face; mono is for tables and chrome. */
  :global(.art__caption .num) {
    font-family: inherit;
    font-style: inherit;
    font-weight: inherit;
  }

  /*
    Method and metrics: a native <details> that ships closed at every width,
    styled as the home Updates row: one ruled row across the column, the
    words in the UI face, the chevron at the right edge pointing down (up once
    open). Inside, the method paragraph, the demo's second plate where it has
    one (its island hydrates once the row is opened), the table caption and
    the table, whose own bottom rule closes the block. The budget gate counts only the
    summary of a closed <details>; /research.md prints everything.
  */
  .more {
    display: grid;
    gap: var(--space-3);
    width: 100%;
  }
  /*
    A plate folded into the row keeps the plate rhythm above and below it, so
    its caption never runs into the table caption. The row's content renders
    as one block (::details-content), which the grid gap does not reach.
  */
  .more > :global(.art) {
    margin-block: var(--space-3);
  }
  .more__summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    column-gap: var(--space-3);
    align-items: center;
    padding-block: 0.6rem;
    border-block: 1px solid var(--line);
    font-family: var(--font-ui);
    font-size: var(--size-ui);
    line-height: 1.5;
    color: var(--ink-2);
    list-style: none;
    cursor: pointer;
    transition: color var(--duration-quick) var(--ease-out);
  }
  .more__summary::-webkit-details-marker {
    display: none;
  }
  /* Phosphor caret-down, inline; it turns over when the row opens. */
  .more__chevron {
    justify-self: end;
    width: 1rem;
    height: 1rem;
    color: var(--ink-3);
    transition:
      transform var(--duration-quick) var(--ease-out),
      color var(--duration-quick) var(--ease-out);
  }
  .more__chevron :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    fill: currentColor;
  }
  .more[open] > .more__summary .more__chevron {
    transform: rotate(180deg);
  }
  .more__summary:hover {
    color: var(--ink);
  }
  .more__summary:hover .more__chevron {
    color: var(--ink);
  }
  .more__summary:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 2px; /* just outside the row: inside, it ran through the first glyph */
  }
  @media (prefers-reduced-motion: reduce) {
    .more__chevron {
      transition-property: color;
    }
  }
</style>
