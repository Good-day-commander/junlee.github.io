---
/*
  /research: three worked examples with public data (Flow, Image, Pulse),
  each a header row with its number, one artifact on film plates, one
  paragraph, the metrics table and one citation line. The page head is the
  h1 and one line; a closing row names the work that has no public data
  yet and says it is on the CV, in plain text (round 3b: the nav's CV is
  in the same last viewport, so the row adds no second CV link). Budget (checked by the build): 750 visible words in
  <main>, 230 per chapter.

  Every number is computed from content.ts or the PINO / pulse / image
  manifests through lib/schema.ts and components/research/data.ts, the
  same sources as /research.md.
*/
import Base from '@/layouts/Base.astro';
import Frame from '@/components/Frame.astro';
import Chapter from '@/components/research/Chapter.astro';
import MetricsTable from '@/components/research/MetricsTable.astro';
import Cite from '@/components/research/Cite.astro';
import CwtStrip from '@/components/research/CwtStrip.astro';
import VesselViewer from '@/islands/VesselViewer';
import FfrCurve from '@/islands/FfrCurve';
import SpectrogramDevelop from '@/islands/SpectrogramDevelop';
import { rasterAxes } from '@/islands/pulse/raster';
import PhaseScrubber from '@/islands/PhaseScrubber';
import { imageManifest, imageManifestUrl } from '@/islands/image/data';
import { figureLabel } from '@/islands/image/manifest';
import { publications, profile } from '@/data/content';
import { formatDecimal, formatMm, formatSeconds } from '@/lib/format';
import { pino, pulse, urls } from '@/components/research/data';
import replayIcon from '@phosphor-icons/core/assets/regular/arrow-counter-clockwise.svg?raw';
import Button from '@/components/Button.astro';
import { flow, fronts, image, pulseFacts, researchClosing, researchLine, timingLine } from '@/lib/schema';
import centerline from '../../public/data/pino/centerline.json';

/* Extent of the Pd/Pa curve's s axis, so the static HTML carries the plate's range. */
const sMax = Math.max(...(centerline.s_mm as number[]));

/* Publications by id, so a missing id fails the build instead of rendering a hole. */
function pub(id: string) {
  const p = publications.find((x) => x.id === id);
  if (!p) throw new Error(`research.astro: publication ${id} missing from content.ts`);
  return p;
}
const C1 = pub('C1');
const J1 = pub('J1');
const M1 = pub('M1');

const c = pino.metrics.case;
const probes = pino.geometry.ffr_probes;
const im = imageManifest;
/* Spectrogram axes at build time (the STFT shows its recommended crop), so the ticks and dB range are in the server HTML. */
const stftAxes = rasterAxes(pulse.stft, pulse.stft.recommended_crop_hz);

const description = `Three worked examples of ${profile.name}'s practice, with data: a neural operator that returns a patient's pressure field in ${flow.inference}, diffusion-synthesized 4D CT for time-resolved FFR, and smartwatch PPG for fluid-bolus need.`;
---

<Base
  title="Research"
  description={description}
  ogImage="/og/research.png"
  ogAlt={`${profile.name}, Research: the page heading and its line, "${researchLine}"`}
>
  <header class="r-head wrap">
    <h1 class="r-head__title">Research</h1>
    <p class="r-head__line">{researchLine}</p>
  </header>

  <!-- ───────────────────────────── Flow ───────────────────────────── -->
  <Chapter id="flow" heading="Flow" claim={fronts[0].row} meta={timingLine}>
    <Fragment slot="artifact">
      <div class="art-grid">
        <figure class="art">
          <Frame plate class="art__frame art__frame--viewer" tl="Surface pressure">
            <VesselViewer client:visible manifestUrl={urls.pinoManifest} mode="chapter" />
          </Frame>
          <figcaption class="art__caption">
            Surface pressure, CFD left and PINO right; slide or toggle to compare. Pressure R²
            <span class="num">{formatDecimal(c.pressure_Pa.R2, 3)}</span>.
          </figcaption>
        </figure>
        <figure class="art">
          <Frame
            plate
            class="art__frame art__frame--curve"
            tl="Pd / Pa along s"
            tr={`probes ${formatMm(probes.proximal.s_mm)} · ${formatMm(probes.distal.s_mm)}`}
          >
            <FfrCurve client:visible centerlineUrl={urls.centerline} mode="chapter" />
          </Frame>
          <figcaption class="art__caption">
            Pd/Pa along the vessel, <span class="num">0 to {formatMm(sMax)}</span> from the inlet; at the probe planes CFD and PINO are
            <span class="num">{flow.ffrDelta}</span> apart.
          </figcaption>
        </figure>
      </div>
    </Fragment>

    <p class="t-prose">
      The current PINO is a geometry-informed neural operator (GINO backbone). From the vessel surface it returns pressure
      and velocity at all {flow.volumeNodes} volume nodes, with a pressure-only Navier–Stokes residual in its loss. Each
      case is predicted by the fold model that never saw it.
    </p>

    <MetricsTable
      id="flow-metrics"
      label="PINO metrics, this case against the cohort"
      caption={`${flow.label.replace(/^./, (s) => s.toUpperCase())}. This case ranks ${flow.rank} by pressure R².`}
      head={['Metric', 'This case', `Cohort median, n = ${flow.cohortN}`]}
      rows={flow.rows}
    />

    <Cite pub={C1} />
  </Chapter>

  <!-- ───────────────────────────── Image ──────────────────────────── -->
  <Chapter id="image" heading="Image" claim={fronts[1].row}>
    <Fragment slot="artifact">
      <figure class="art">
        <Frame plate class="art__frame" tr={`${im.source.paper_id} · ${figureLabel(im)}`}>
          <PhaseScrubber client:visible manifestUrl={imageManifestUrl} manifest={im} />
        </Frame>
        <figcaption class="art__caption">
          Pressure and wall shear stress through one cardiac cycle; {image.acquiredList} acquired by CT, the other
          {' '}{image.synthesized} synthesized.
        </figcaption>
      </figure>
    </Fragment>

    <p class="t-prose">
      A denoising diffusion deformable model synthesizes a full-cycle 4D coronary CT from two acquired phases. The
      sequence is then meshed and solved, so FFR can be followed across the cycle instead of read from one static phase.
      The diffusion model is T.H. Han's work; mine is the CFD and FFR analysis on the synthesized frames.
    </p>

    <MetricsTable
      id="image-metrics"
      label="4D CT synthesis and CT-FFR metrics reported in the paper"
      caption={`Reported in ${J1.id}, the 4D CT paper.`}
      head={['Metric', 'Value']}
      rows={[
        ['4D CT-FFR accuracy against invasive FFR', `${image.ffrAccuracy} %`],
        ['Synthesis PSNR', image.psnr],
        ['Synthesis SSIM', image.ssim],
        ['Synthesis Dice', image.dice],
      ]}
    />

    <Cite pub={J1} />
  </Chapter>

  <!-- ───────────────────────────── Pulse ──────────────────────────── -->
  <Chapter id="pulse" heading="Pulse" claim={fronts[2].row}>
    <Fragment slot="artifact">
      <div class="art-grid">
        <figure class="art">
          <Frame plate class="art__frame art__frame--stft" tl="PPG · STFT">
            <SpectrogramDevelop
              recordingS={pulseFacts.durationS}
              client:visible
              manifestUrl={urls.pulseManifest}
              variant="stft"
              axes={stftAxes}
              method={pulse.stft.method}
              replayGroup="pulse"
              bare
            />
          </Frame>
          <figcaption class="art__caption">
            One <span class="num">{formatSeconds(pulseFacts.durationS, 0)}</span> smartwatch recording, taken before the first bolus; the
            cardiac band is the bright line.
          </figcaption>
        </figure>
        <CwtStrip />
      </div>
      <!-- One Replay for both plates; shown once the islands can hear it (hidden without JS). -->
      <div class="pulse-replay" data-replay-group="pulse" hidden>
        <Button variant="ghost" size="compact" aria-label="Replay both spectrograms">
          Replay
          <span slot="icon" aria-hidden="true" set:html={replayIcon} />
        </Button>
      </div>
    </Fragment>

    <p class="t-prose">
      Green-channel PPG at {pulseFacts.fs} Hz is band-passed, normalized in short windows and cut into overlapping
      segments, each turned into an STFT or CWT image. Six CNN configurations, each kept as five fold checkpoints, make
      {' '}{pulseFacts.networks} networks whose patient-level scores are combined by a non-negative weighted average. The
      target is an intravenous fluid bolus within 24 hours of emergency-department arrival.
    </p>

    <MetricsTable
      id="pulse-metrics"
      label="Fluid-bolus prediction at patient level"
      caption={`From ${M1.id}, ${pulseFacts.status}. The development weights and cutoff were chosen on those predictions; the temporal set was scored unchanged.`}
      head={['Set', 'AUC [95 % CI]', 'n']}
      rows={[
        ['Development, out-of-fold', `${pulseFacts.devAuc} [${pulseFacts.devCi}]`, pulseFacts.devN],
        ['Same-center temporal set', `${pulseFacts.tempAuc} [${pulseFacts.tempCi}]`, pulseFacts.tempN],
      ]}
    />

    <Cite pub={M1} />
  </Chapter>

  <section class="r-more wrap" aria-label="More work on the CV">
    <p class="r-more__line">
      {researchClosing}
    </p>
  </section>
</Base>

<script>
  /* The Pulse chapter's one Replay restarts both spectrogram plates (SpectrogramDevelop replayGroup). */
  for (const box of document.querySelectorAll<HTMLElement>('[data-replay-group]')) {
    const group = box.dataset.replayGroup;
    box.hidden = false;
    box.querySelector('button')?.addEventListener('click', () => {
      document.dispatchEvent(new CustomEvent('spectrogram:replay', { detail: { group } }));
    });
  }
</script>

<style>
  .r-head {
    padding-block: var(--space-5) 0;
    display: grid;
    gap: var(--space-2);
  }
  .r-head__title {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 92;
    font-weight: 600;
    font-size: clamp(2.25rem, 1.6rem + 3vw, 4rem);
    line-height: 1;
    letter-spacing: -0.025em;
  }
  .r-head__line {
    font-family: var(--font-text);
    font-size: var(--size-prose);
    line-height: var(--leading-prose);
    color: var(--ink-2);
    max-width: var(--measure);
    text-wrap: pretty;
  }

  /*
    Two artifacts side by side (stacked under 960px). Each frame is a flex
    column whose body takes the slack, so the pair ends on one line.
  */
  .art-grid {
    display: grid;
    gap: var(--space-3);
    align-items: stretch;
  }
  @media (min-width: 960px) {
    .art-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }
  }
  :global(.art) {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: var(--space-1);
    margin: 0;
    min-width: 0;
  }
  :global(.art) > :global(.art__frame) {
    display: flex;
    flex-direction: column;
  }
  :global(.art) > :global(.art__frame > .frame__body) {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  /* The curve starts below the corner chrome instead of running under it. */
  :global(.art) :global(.art__frame--curve > .frame__body) {
    padding-top: calc(var(--corner-inset) + 1.75rem);
  }
  /* Spectrograms: the plot holds the top of the body and the toolbar its bottom. */
  .art-grid :global(.art__frame--stft > .frame__body),
  .art-grid :global(.art__frame--cwt > .frame__body) {
    justify-content: flex-start;
  }
  .art-grid :global(.pulse--bare) {
    flex: 1 0 auto;
    align-content: space-between;
  }
  .art-grid :global(.pulse__bar > .pulse__btn) {
    margin-left: auto;
  }
  .pulse-replay {
    margin-top: var(--space-2);
  }
  .pulse-replay[hidden] {
    display: none;
  }
  :global(.art__caption),
  :global(.art) :global(.art__caption) {
    font-family: var(--font-text);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 62ch;
    text-wrap: pretty;
  }
  /* Under 640px two corner labels per edge collide; keep the case id. */
  @media (max-width: 640px) {
    :global(.art__frame--viewer .frame__corner--tr) {
      display: none;
    }
  }

  .r-more {
    padding-top: var(--space-6);
  }
  .r-more__line {
    padding-top: var(--space-2);
    border-top: 1px solid var(--line);
    font-family: var(--font-text);
    font-size: var(--size-prose);
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 72ch;
  }
</style>
