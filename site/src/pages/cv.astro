  .row__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.35;
    text-wrap: pretty;
  }
  /* The place (institution, city) is its own line under the title, never run on after it. */
  /* The grant number under the funder line (a wrapped " · number" used to open a line with the separator). */
  .row__grant {
    display: block;
    margin-top: 0.1rem;
  }
  .row__inline {
    display: block;
    font-family: var(--font-text);
    font-weight: 400;
    font-size: 0.975rem;
