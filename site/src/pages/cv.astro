    line-height: 1.4;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .patent__no {
    color: var(--ink);
    min-width: 10rem; /* the longest application label; every status then ends on the same x */
    text-align: right;
  }
  .patent__status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  /* Talk photographs: one 120 px row */
  .photos {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }
  .photo__plate {
    margin: 0;
    display: grid;
    gap: 0.3rem;
  }
  .photo :global(.photo__img) {
    height: 120px;
    width: auto;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg-1);
    transition: border-color var(--duration-quick) var(--ease-out);
  }
  .photo__link {
    display: inline-block;
    line-height: 0;
    border-radius: var(--radius);
  }
  .photo__link:hover :global(.photo__img) {
    border-color: var(--ink-3);
  }
  .photo__link:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: var(--ring-offset);
  }
  .photo__caption {
    color: var(--ink-2);
  }
  /*
    Click-to-enlarge: one film plate in a native dialog; Escape, the button or
    the backdrop closes it. The image box is sized before the file arrives
    (the script sets --ar and --lw from the link's data-w and data-h), so the
    dialog opens at its final size. The dialog and its flat dim fade in over
    --duration-base and out over --duration-quick, opacity only; where
    overlay and display cannot transition (Firefox, Safari) the close is
    instant.
  */
  .lightbox,
  .lightbox::backdrop {
    opacity: 0;
    transition:
      opacity var(--duration-base) var(--ease-out),
      overlay var(--duration-base) allow-discrete,
      display var(--duration-base) allow-discrete;
  }
  .lightbox[open],
  .lightbox[open]::backdrop {
    opacity: 1;
  }
  @starting-style {
    .lightbox[open],
    .lightbox[open]::backdrop {
      opacity: 0;
    }
  }
  .lightbox:not([open]),
  .lightbox:not([open])::backdrop {
    transition-duration: var(--duration-quick);
  }
  .lightbox {
    /* The global reset zeroes margins; a dialog centres itself only with margin: auto. */
    position: fixed;
    inset: 0;
    margin: auto;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--ink);
    max-width: min(92vw, 1800px);
    max-height: 92vh;
    overflow: hidden;
  }
  .lightbox::backdrop {
    background: oklch(0.1 0.008 250 / 0.82);
  }
  .lightbox__img {
    display: block;
    aspect-ratio: var(--ar);
    width: min(92vw, 1800px, calc((92vh - 3rem) * var(--ar)), var(--lw));
    max-width: min(92vw, 1800px);
    max-height: calc(92vh - 3rem);
  }
  .lightbox__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 0.6rem 0.9rem;
    border-top: 1px solid var(--line);
  }
  .lightbox__caption {
    color: var(--ink-2);
  }
  .lightbox__close {
    padding: 0.3rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: border-color var(--duration-quick) var(--ease-out);
  }
  .lightbox__close:hover {
    border-color: var(--signal);
  }
  .lightbox__close:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: var(--ring-offset);
  }
  .photo__caption a {
    color: var(--ink-2);
    text-decoration-color: var(--line);
  }
  .photo__caption a:hover {
    color: var(--ink);
    text-decoration-color: var(--signal);
  }

  /* Skills */
  .skills {
    display: grid;
    gap: 0.25rem;
  }
  .skills__group {
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1fr);
    gap: var(--space-3);
  }
  .skills dt {
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--size-ui);
  }
  .skills dd {
    margin: 0;
    font-family: var(--font-text);
    font-size: 0.975rem;
    line-height: 1.5;
    color: var(--ink-2);
    max-width: none;
  }

  @media (max-width: 760px) {
    .cv-head :global(.cv-head__portrait) {
      width: 4rem;
      height: 4rem;
    }
    .row,
    .skills__group {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.1rem;
    }
    .row__lead {
      padding-top: 0;
    }
    .row__inline {
      display: block;
      margin-left: 0;
    }
    .row__inline::before {
      content: none;
    }
    .talk {
      grid-template-columns: 2.5rem auto minmax(0, 1fr);
      gap: 0.1rem var(--space-2);
    }
    .talk__title {
      grid-column: 2 / -1;
    }
    .talk__venue {
      grid-column: 2;
    }
    .talk__format {
      grid-column: 3;
      text-align: left;
    }
    .patent {
      grid-template-columns: 2.5rem minmax(0, 1fr);
      gap: 0.1rem var(--space-2);
    }
    .patent__meta {
      grid-column: 2;
      justify-content: flex-start;
      white-space: normal;
    }
    .patent__no {
      min-width: 0;
      text-align: left;
    }
    .photo :global(.photo__img) {
      height: 96px;
    }
  }
  /*
    Under 22rem (a phone at 200 % zoom): the portrait sits over the name, a
    talk's venue and format take their own lines under the title, a format
    may break inside itself, and a patent's mark and number may stack.
  */
  @media (max-width: 21.98rem) {
    .cv-head,
    .cv-head__id {
      grid-template-columns: minmax(0, 1fr);
    }
    .talk {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }
    .talk__venue,
    .talk__format {
      grid-column: 2;
    }
    .talk__unit {
      white-space: normal;
    }
    .patent__status {
      flex-wrap: wrap;
    }
  }

  @media print {
    .cv-head {
      grid-template-columns: 1fr;
      padding-bottom: 0.8rem;
    }
    .cv-head__name {
      font-size: 22pt;
    }
    .cv-head__role,
    .cv-head__intro,
    .row__meta,
    .row__inline,
    .talk__note,
    .patent__meta,
    .skills dd {
      font-size: 10pt;
      line-height: 1.4;
    }
    .row__title,
    .talk__title,
    .patent__title {
      font-size: 10.5pt;
    }
    .row,
    .talk,
    .patent,
    .list :global(.pub) {
      break-inside: avoid;
    }
    .group__heading {
      break-after: avoid;
    }
    /*
      A talk prints in three columns: the title takes the width the venue and
      format columns gave up, and the venue sits over the format on the right.
    */
    .talk {
      grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    }
    .talk__title {
      grid-column: 2;
      grid-row: span 2;
    }
    .talk__venue,
    .talk__format {
      grid-column: 3;
      text-align: right;
    }
    /* A registered patent's number line wraps under its status, so its title is not squeezed into a narrow column. */
    .patent__meta {
      max-width: 21rem;
    }
    .patent__no {
      min-width: 0;
    }
  }
</style>

<script>
  /* Talk photographs: open the full-size image in the dialog instead of navigating; without JS the link still opens the image. */
  const dialog = document.getElementById('photo-lightbox') as HTMLDialogElement | null;
  if (dialog && typeof dialog.showModal === 'function') {
    const img = dialog.querySelector<HTMLImageElement>('.lightbox__img')!;
    const cap = dialog.querySelector<HTMLElement>('.lightbox__caption')!;
    document.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]').forEach((a) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        const w = Number(a.dataset.w);
        const h = Number(a.dataset.h);
        if (w > 0 && h > 0) {
          img.style.setProperty('--ar', String(w / h));
          img.style.setProperty('--lw', `${w}px`);
        }
        img.src = a.href;
        img.alt = a.dataset.alt ?? '';
        cap.textContent = a.dataset.caption ?? '';
        dialog.showModal();
      });
    });
    dialog.querySelector('[data-lightbox-close]')?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => {
      const r = dialog.getBoundingClientRect();
      const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      if (e.target === dialog || !inside) dialog.close();
    });
    /* The image stays until the dialog has faded out (its closed transition-duration, always in seconds when computed). */
    dialog.addEventListener('close', () => {
      const fade = parseFloat(getComputedStyle(dialog).transitionDuration) * 1000 || 0;
      window.setTimeout(() => dialog.open || img.removeAttribute('src'), fade);
    });
  }
</script>
