  /* The research interests, one sentence under the name (the #interests anchor). */
  .cv-head__intro {
    font-family: var(--font-text);
    font-size: 1.125rem;
    line-height: 1.45;
    color: var(--ink);
    text-wrap: pretty;
    margin-bottom: 0.2rem;
  }
  .cv-note__unit {
    white-space: nowrap;
  }
  .cv-note {
    color: var(--ink-3);
    margin-bottom: var(--space-1);
