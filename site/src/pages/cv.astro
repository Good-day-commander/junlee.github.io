---
/*
  /cv: the whole record, dense (contract revision 2). It absorbs the
  retired /publications and /record pages, so every fact they showed is
  here: every publication with its authors, citation, role, doi and
  BibTeX, the publication counts, every talk as one row (year, title, short
  venue with the full venue and location in its abbr, format and role; the
  author line where it is not mine et al.), the three talk photographs, every patent filing with
  its status and number, the funded projects,
  awards, fellowships and teaching.

  Rows, not frames; one entry is about two lines; section gaps are 24px;
  one left edge. A sticky action bar under the nav keeps the PDF and
  LinkedIn on screen; Email is the nav's. Because the bar carries LinkedIn
  in every viewport, this page's footer row omits it (Google Scholar and
  ORCID only). Prints as a document (no nav,
  bar, footer or photos; the sections run on, a heading never ends a page
  and no row or publication splits across two).

  Short for people, complete for agents (round 3): the appointment bullets
  (each restates a [J#]/[C#] row below) and the patent inventor lists are
  not printed here; cv.md, llms-full.txt and cv.json carry them in full.

  Phones (640px and under): a jump row of the section headings under the
  header, and Talks, Patents, Funded projects, Awards, Teaching and Skills
  folded to their heading rows (CvSection fold; the inline script after the
  article closes them on load and opens the one an anchor points into).
*/
import { Image, getImage } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import CvSection from '@/components/record/CvSection.astro';
import PubEntry from '@/components/record/PubEntry.astro';
import Tag from '@/components/record/Tag.astro';
import {
  awards,
  education,
  experience,
  fellowships,
  profile,
  publications,
  skills,
  talks,
  teaching,
  projects,
  type Publication,
  type Talk,
} from '@/data/content';
import {
  applicationLabel,
  awardPublication,
  capitalize,
  leads,
  normRange,
  period,
  publicPatents,
} from '@/components/record/records';
import { CV_PDF, counts, interestsLine, projectsHeading, talkShortVenue } from '@/lib/schema';
import filePdf from '@phosphor-icons/core/assets/regular/file-pdf.svg?raw';
import arrowUpRight from '@phosphor-icons/core/assets/regular/arrow-up-right.svg?raw';
import portrait from '@/assets/photos/profile-main.jpg';
import photoAcfm from '@/assets/photos/gallery-acfm-2025.jpg';
import photoDmd from '@/assets/photos/gallery-dmd-2026.jpg';
import photoYonsei from '@/assets/photos/gallery-talk-yonsei.jpg';
import photoBesco25 from '@/assets/photos/gallery-besco-2025.jpg';
import photoBesco24 from '@/assets/photos/gallery-besco-2024.jpg';

const pubGroups: { heading: string; items: Publication[] }[] = [
  { heading: 'Journal articles (SCIE)', items: publications.filter((p) => p.type === 'journal') },
  { heading: 'Peer-reviewed proceedings', items: publications.filter((p) => p.type === 'proceedings') },
  { heading: 'Manuscript under revision', items: publications.filter((p) => p.type === 'under-review') },
];
const leadCount = publications.filter(leads).length;

/* An empty category prints nothing (no heading over an empty list), as pubGroups does. */
const talkGroups: { heading: string; items: Talk[] }[] = [
  { heading: 'International', items: talks.filter((t) => t.category === 'International') },
  { heading: 'Domestic', items: talks.filter((t) => t.category === 'Domestic') },
].filter((g) => g.items.length > 0);
const presented = talks.filter((t) => t.role === 'presenter').length;

const skillGroups: { label: string; items: string[] }[] = [
  { label: 'Computational', items: skills.computational },
  { label: 'Machine learning', items: skills.ml },
  { label: 'Data', items: skills.data },
  { label: 'Languages', items: skills.languages },
].filter((g) => g.items.length > 0);

/* The count lines under the section headings leave out a zero term (never "0 under revision"). */
const nonZero = <T extends { n: number }>(terms: T[]) => terms.filter((t) => t.n > 0);
const pubNote = nonZero([
  { n: counts.journal, word: 'journal articles' },
  { n: counts.proceedings, word: 'proceedings' },
  { n: counts.underReview, word: 'under revision' },
]).map((t) => `${t.n} ${t.word}`);
const talkNote = nonZero([
  { n: counts.talks, word: 'talks', tail: '' },
  { n: counts.talksInternational, word: 'international', tail: '' },
  { n: counts.talksDomestic, word: 'domestic', tail: '' },
  { n: presented, word: 'presented', tail: ' by me' },
]);
const patentNote = nonZero([
  { n: counts.patents, word: 'filings' },
  { n: counts.patentsRegistered, word: 'registered' },
  { n: counts.patents - counts.patentsRegistered, word: 'pending' },
]).map((t) => `${t.n} ${t.word}`);

/*
  Talk photographs, 120 px tall in one row. Two document talks in the record
  and their captions are read from those rows; the Yonsei symposium has no
  CV entry, so its caption is the old site's gallery copy.
*/
const talkById = (id: string) => talks.find((t) => t.id === id);
/*
  Talk rows are one table row each (packet §6): year · title · short venue ·
  format and role. The short venue is the acronym the record already carries
  ("(DMD2026)", "(ACFM)"), or the venue without its year (lib/schema.ts
  talkShortVenue, which fails the build past 14 characters); the full venue
  and the location sit in the abbr's title. The author line is printed only
  where it is not the default "H.J. Lee et al."
*/
const DEFAULT_AUTHORS = 'H.J. Lee et al.';
const acronym = (venue: string) => venue.match(/\(([A-Z][A-Za-z0-9]+)\)/)?.[1];
function talkCaption(t: Talk | undefined, fallback: string): { text: string; href?: string } {
  if (!t) return { text: fallback };
  const a = acronym(t.venue);
  const name = a ? (a.includes(t.year) ? a.replace(t.year, ` ${t.year}`) : `${a} ${t.year}`) : `${t.venue} ${t.year}`;
  /* Venue and year plus the format; the city stays in the talk row, so five captions fit one line of photos. */
  return { text: `${name} · ${capitalize(t.format)}`, href: `#${t.id}` };
}
const I3 = talkById('I3');
const I1 = talkById('I1');
const D1 = talkById('D1');
const D3 = talkById('D3');
const PHOTO_H = 120;
/* Newest first. Each photo is the owner's own, from the conference named in its caption (owner's shared album, 2026-10-19). */
const photos = [
  {
    src: photoDmd,
    alt: I1 ? `${profile.name} presenting the poster "${I1.title}" at the ${I1.venue}, ${I1.location}.` : `${profile.name} presenting a conference poster.`,
    caption: talkCaption(I1, 'DMD 2026, Minneapolis'),
  },
  {
    src: photoAcfm,
    alt: I3 ? `${profile.name} presenting at the podium of the ${I3.venue}, ${I3.location}.` : `${profile.name} at a conference podium.`,
    caption: talkCaption(I3, 'ACFM 2025, Seoul'),
  },
  {
    src: photoBesco25,
    alt: D1 ? `${profile.name} beside the poster "${D1.title}" at the ${D1.venue}, ${D1.location}.` : `${profile.name} beside a conference poster.`,
    caption: talkCaption(D1, 'BESCO 2025'),
  },
  {
    src: photoBesco24,
    alt: D3 ? `${profile.name} beside the poster "${D3.title}" at the ${D3.venue}, ${D3.location}.` : `${profile.name} beside a conference poster.`,
    caption: talkCaption(D3, 'BESCO 2024'),
  },
  {
    src: photoYonsei,
    alt: `${profile.name} presenting cardiovascular AI research at a Yonsei department symposium.`,
    caption: { text: 'Yonsei symposium 2024' } as { text: string; href?: string },
  },
].map((ph) => ({ ...ph, width: Math.round((PHOTO_H * ph.src.width) / ph.src.height) }));
/* Full-size versions for the click-to-enlarge view (one optimized WebP per photo, at most 1800 px wide). */
const photoFull = await Promise.all(photos.map((ph) => getImage({ src: ph.src, width: Math.min(1800, ph.src.width), format: 'webp', quality: 82 })));

const links = [
  { label: 'Google Scholar', href: profile.links.scholar },
  { label: 'ORCID', href: profile.links.orcid },
];

/* A section whose list is empty drops itself and its jump-row link (no change with today's record). */
const filled: Record<string, boolean> = {
  education: education.length > 0,
  appointments: experience.length > 0,
  publications: publications.length > 0,
  talks: talks.length > 0,
  patents: publicPatents.length > 0,
  projects: projects.length > 0,
  awards: awards.length + fellowships.length > 0,
  teaching: teaching.length > 0,
  skills: skillGroups.length > 0,
};

/* The phone jump row: one link per section, in the page's order, with the section headings' own words. */
const jump = [
  { id: 'education', label: 'Education' },
  { id: 'appointments', label: 'Appointments' },
  { id: 'publications', label: 'Publications' },
  { id: 'talks', label: 'Talks' },
  { id: 'patents', label: 'Patents' },
  { id: 'projects', label: 'Projects' },
  { id: 'awards', label: 'Awards' },
  { id: 'teaching', label: 'Teaching' },
  { id: 'skills', label: 'Skills' },
].filter((j) => filled[j.id]);

const description = `Curriculum vitae of ${profile.name}: education, appointments, publications, talks, patents, funded projects, awards, teaching and skills.`;
---

<Base
  title="CV"
  description={description}
  ogImage="/og/cv.png"
  ogAlt={`${profile.name}, curriculum vitae: the CV action bar, his portrait and the head of the CV.`}
  footer={{ omit: ['LinkedIn'] }}
  width="record"
>
  <div class="cv-bar">
    <div class="wrap cv-bar__row">
      <div class="cv-bar__actions">
        <Button variant="ghost" href={CV_PDF} external size="compact">
          Download PDF
          <span slot="icon" aria-hidden="true" set:html={filePdf} />
        </Button>
        <a class="cv-bar__link" href={profile.links.linkedin} rel="me noopener">
          LinkedIn<span class="cv-bar__icon" aria-hidden="true" set:html={arrowUpRight} />
        </a>
      </div>
    </div>
  </div>

  <article class="cv wrap">
    <header class="cv-head">
      <Image
        src={portrait}
        alt={`${profile.name}, portrait.`}
        width={80}
        height={80}
        densities={[1, 2]}
        format="webp"
        quality={85}
        class="cv-head__portrait"
      />
      <div class="cv-head__id">
        <h1 class="cv-head__name">{profile.name}</h1>
        <p id="interests" class="cv-head__intro">{interestsLine}</p>
        <p class="cv-head__role">
          {profile.role}, {profile.lab}, {profile.department}, {profile.university}
        </p>
        <p class="cv-head__role cv-head__role--second">
          {profile.concurrent.role}, {profile.concurrent.org}, {profile.concurrent.project}
        </p>
        <ul class="cv-head__contact t-mono">
          <li>{profile.email}</li>
          {
            links.map((l) => (
              <li>
                <a href={l.href} rel="me noopener">
                  {l.label}
                </a>
              </li>
            ))
          }
          <li>{profile.links.site.replace(/^https?:\/\//, '')}</li>
        </ul>
      </div>
    </header>

    <nav class="cv-jump t-mono" aria-label="Sections">
      {/* One line of markup: a wrap falls after a dot, never before one. */}
      {jump.map((j, i) => <>{i > 0 && <span class="cv-jump__sep">{'\u00a0· '}</span>}<a href={`#${j.id}`}>{j.label}</a></>)}
    </nav>

    <CvSection heading="Education" id="education" empty={!filled.education}>
      <ol class="rows">
        {
          education.map((e) => (
            <li class="row">
              <span class="row__lead t-mono">{period(e.start, e.end)}</span>
              <div class="row__main">
                <p class="row__title">
                  {e.degree}
                  <span class="row__inline">
                    {e.institution}, {e.location}
                  </span>
                </p>
                {e.note && <p class="row__meta">{e.note}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    </CvSection>

    <CvSection heading="Appointments" id="appointments" empty={!filled.appointments}>
      <ol class="rows">
        {
          experience.map((x) => (
            <li class="row">
              <span class="row__lead t-mono">{period(x.start, x.end)}</span>
              <div class="row__main">
                <p class="row__title">
                  {x.role}
                  <span class="row__inline">
                    {x.org}, {x.location}
                  </span>
                </p>
                {x.notes && x.notes.map((n) => <p class="row__meta row__meta--note">{n}</p>)}
              </div>
            </li>
          ))
        }
      </ol>
    </CvSection>

    <CvSection heading="Publications" id="publications" empty={!filled.publications}>
      <p class="cv-note t-mono">{[...pubNote, '† first author', '* corresponding author'].join(' · ')}</p>
      {
        pubGroups.map(
          (g) =>
            g.items.length > 0 && (
              <div class="group">
                <h3 class="group__heading">{g.heading}</h3>
                <ol class="list">
                  {g.items.map((p) => (
                    <PubEntry pub={p} />
                  ))}
                </ol>
              </div>
            ),
        )
      }
    </CvSection>

    <CvSection heading="Talks" id="talks" fold empty={!filled.talks}>
      <ul class="photos">
        {
          photos.map((ph, i) => (
            <li class="photo">
              <figure class="photo__plate">
                <a
                  class="photo__link"
                  href={photoFull[i].src}
                  data-lightbox
                  data-w={photoFull[i].attributes.width}
                  data-h={photoFull[i].attributes.height}
                  data-alt={ph.alt}
                  data-caption={ph.caption.text}
                  aria-label={`Enlarge: ${ph.caption.text}`}
                >
                  <Image
                    src={ph.src}
                    alt={ph.alt}
                    width={ph.width}
                    height={PHOTO_H}
                    densities={[1, 2]}
                    format="webp"
                    quality={78}
                    loading="lazy"
                    class="photo__img"
                  />
                </a>
                <figcaption class="photo__caption t-mono">
                  {ph.caption.href ? <a href={ph.caption.href}>{ph.caption.text}</a> : ph.caption.text}
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
      <dialog class="lightbox plate" id="photo-lightbox" aria-label="Enlarged photograph">
        <img class="lightbox__img" alt="" />
        <div class="lightbox__bar">
          <p class="lightbox__caption t-mono"></p>
          <button type="button" class="lightbox__close t-mono" data-lightbox-close>Close</button>
        </div>
      </dialog>
      <p class="cv-note t-mono">
        {talkNote.map((t, i) => <>{i > 0 && ' · '}<span class="cv-note__unit">{t.n} {t.word}</span>{t.tail}</>)}
      </p>
      {
        talkGroups.map((g) => (
          <div class="group">
            <h3 class="group__heading">{g.heading}</h3>
            <ol class="list">
              {g.items.map((t) => (
                <li class="talk" id={t.id}>
                  <span class="talk__year t-mono">{t.year}</span>
                  <p class="talk__title">
                    {t.title}
                    {t.note !== DEFAULT_AUTHORS && <span class="talk__note">{t.note}</span>}
                  </p>
                  <abbr class="talk__venue t-mono" title={`${t.venue}, ${t.location}`}>
                    {talkShortVenue(t.venue)}
                  </abbr>
                  <span class="talk__format t-mono">
                    {capitalize(t.format)
                      .split('; ')
                      .map((part, i, all) => (
                        <>
                          <span class="talk__unit">{part}{i < all.length - 1 && ';'}</span>{' '}
                        </>
                      ))}
                    <span class="talk__unit">· {t.role === 'presenter' ? 'presented' : 'co-author'}</span>
                  </span>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </CvSection>

    <CvSection heading="Patents" id="patents" fold empty={!filled.patents}>
      <p class="cv-note t-mono">{patentNote.join(' · ')}</p>
      <ol class="list">
        {
          publicPatents.map((p) => (
            <li class="patent" id={p.id}>
              <span class="patent__id t-mono">{p.id}</span>
              <p class="patent__title">{p.title}</p>
              <p class="patent__meta t-mono">
                {p.status === 'registered' && p.registrationNo ? (
                  <span class="patent__status">
                    <Tag tone="ink">Registered</Tag>
                    {`No. ${p.registrationNo}${p.registrationDate ? `, ${p.registrationDate}` : ''}`}
                  </span>
                ) : (
                  <span class="patent__status">pending, filed {p.year}</span>
                )}
                <span class="patent__no">{applicationLabel(p)}</span>
              </p>
            </li>
          ))
        }
      </ol>
    </CvSection>

    <CvSection heading={projectsHeading} id="projects" fold empty={!filled.projects}>
      <ol class="rows">
        {
          projects.map((r) => (
            <li class="row" id={r.id}>
              <span class="row__lead t-mono">{period(r.start, r.end)}</span>
              <div class="row__main">
                <p class="row__title">{r.title}</p>
                <p class="row__meta row__meta--wide">
                  {r.program ? `${r.funder}, ${r.program}` : r.funder}
                  <span class="row__grant t-mono">{r.grantNo}</span>
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </CvSection>

    <CvSection heading="Awards and fellowships" id="awards" fold empty={!filled.awards}>
      <ol class="rows">
        {
          awards.map((a) => {
            const pub = awardPublication(a.forPublication);
            return (
              <li class="row">
                <span class="row__lead t-mono">{a.year}</span>
                <p class="row__title">
                  {a.title}
                  <span class="row__inline">
                    {a.note ? `${a.org}, ${a.note}` : a.org}
                    {pub && (
                      <span>
                        {' '}
                        (<a href={`#${pub.id}`}>{pub.id}</a>)
                      </span>
                    )}
                  </span>
                </p>
              </li>
            );
          })
        }
        {
          fellowships.map((f) => (
            <li class="row">
              <span class="row__lead t-mono">{normRange(f.period)}</span>
              <p class="row__title">
                {f.title}
                <span class="row__inline">Fellowship, {f.org}</span>
              </p>
            </li>
          ))
        }
      </ol>
    </CvSection>

    <CvSection heading="Teaching" id="teaching" fold empty={!filled.teaching}>
      <ol class="rows">
        {
          teaching.map((t) => (
            <li class="row">
              <span class="row__lead t-mono">{normRange(t.period)}</span>
              <p class="row__title">
                {t.role}
                <span class="row__inline">{t.org}</span>
              </p>
            </li>
          ))
        }
      </ol>
    </CvSection>

    <CvSection heading="Skills" id="skills" fold empty={!filled.skills}>
      <dl class="skills">
        {
          skillGroups.map((g) => (
            <div class="skills__group">
              <dt>{g.label}</dt>
              <dd>{g.items.join('; ')}</dd>
            </div>
          ))
        }
      </dl>
    </CvSection>
  </article>
  <script is:inline>
    /*
      Phones: the folding sections start closed (the markup ships them open, so
      agents, print and no-JS readers see everything). An anchor into a folded
      section (/cv/#P3, #talks, #I1) opens it before the browser scrolls: on
      load, on an in-page link, and on hashchange.
    */
    (() => {
      const phone = window.matchMedia('(max-width: 640px)');
      const folds = document.querySelectorAll('details.cv-fold');
      const reveal = (hash) => {
        let el = null;
        try {
          el = hash.length > 1 ? document.getElementById(decodeURIComponent(hash.slice(1))) : null;
        } catch (e) {
          return null;
        }
        const fold = el && (el.closest('details.cv-fold') || el.querySelector(':scope > details.cv-fold'));
        if (!fold || fold.open) return null;
        fold.open = true;
        return el;
      };
      /* Desktop: the summaries leave the tab order and a fold can never close; phones: the folds start closed. */
      const sync = () => {
        folds.forEach((d) => {
          const summary = d.querySelector(':scope > summary');
          if (phone.matches) {
            if (summary) summary.tabIndex = 0;
          } else {
            if (summary) summary.tabIndex = -1;
            d.open = true;
          }
        });
      };
      folds.forEach((d) => d.addEventListener('toggle', () => { if (!phone.matches && !d.open) d.open = true; }));
      if (phone.matches) folds.forEach((d) => d.removeAttribute('open'));
      sync();
      reveal(location.hash);
      document.addEventListener(
        'click',
        (e) => {
          const a = e.target instanceof Element ? e.target.closest('a[href*="#"]') : null;
          if (a && a.pathname === location.pathname) reveal(a.hash);
        },
        true,
      );
      window.addEventListener('hashchange', () => reveal(location.hash)?.scrollIntoView());
      /* Wider than a phone (a turned phone) or printing: every section open, as on desktop. */
      phone.addEventListener('change', sync);
      window.addEventListener('beforeprint', () => folds.forEach((d) => (d.open = true)));
    })();
  </script>
</Base>

<style is:global>
  @media print {
    @page {
      margin: 16mm 18mm;
    }
    html {
      background: white;
    }
    .nav,
    .footer,
    .skip-link,
    .cv-bar,
    .cv-jump,
    .cv-head__portrait,
    .photos,
    .pub__details {
      display: none !important;
    }
    .cv {
      max-width: none;
      padding: 0;
      font-size: 10.5pt;
    }
    a {
      text-decoration: none;
      color: inherit;
    }
  }
</style>

<style>
  /* Under the sticky nav and bar, anchors land below both. */
  :global(html:has(.cv-bar)) {
    scroll-padding-top: calc(var(--nav-h) + 3.25rem);
  }
  .cv-bar {
    position: sticky;
    top: var(--nav-h);
    z-index: 40;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .cv-bar__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-1) var(--space-3);
    min-height: 2.75rem;
    padding-block: 0.3rem;
  }
  .cv-bar__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-1) var(--space-3);
  }
  .cv-bar__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding-block: 0.4rem;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--ink);
    text-decoration-color: var(--line);
  }
  .cv-bar__link:hover {
    text-decoration-color: var(--signal);
  }
  .cv-bar__icon {
    display: inline-flex;
    width: 1em;
    height: 1em;
    color: var(--ink-3);
    transition: color var(--duration-quick) var(--ease-out);
  }
  .cv-bar__icon :global(svg) {
    width: 100%;
    height: 100%;
  }
  .cv-bar__link:hover .cv-bar__icon {
    color: var(--signal);
  }

  .cv {
    padding-top: var(--space-4);
  }

  /* Header */
  .cv-head {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: var(--space-3);
    align-items: start;
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--ink);
  }
  .cv-head__id {
    display: grid;
    gap: 0.3rem;
  }
  .cv-head__name {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 92;
    font-weight: 600;
