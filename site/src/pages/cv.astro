      color: inherit;
      text-decoration-color: var(--line);
      white-space: nowrap;
    }
    .cv-jump a:hover {
      color: var(--ink);
      text-decoration-color: var(--signal);
    }
    .cv-jump__sep {
      color: var(--ink-3);
    }
  }

  /* Period rows (education, appointments, projects, awards, teaching) */
  .rows > .row + .row {
    border-top: 1px solid var(--line-soft);
  }
  .row {
    display: grid;
    grid-template-columns: 10.5rem minmax(0, 1fr);
    gap: 0 var(--space-3);
    padding-block: 0.3rem;
  }
  .row__lead {
    color: var(--ink-2);
    padding-top: 0.15rem;
    white-space: nowrap;
