  /* Talks: one row each: year, title (authors only where not mine et al.), short venue, format and role */
  .talk {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) 7rem 15rem;
    gap: 0 var(--space-2);
    align-items: baseline;
    padding-block: 0.3rem;
    border-bottom: 1px solid var(--line-soft);
