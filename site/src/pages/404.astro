---
/*
  /404: one film plate (a cine frame with no signal), one line, the ways
  back in (the three pages); the nav and the footer still lead to Email
  and the CV. GitHub Pages serves this file for every unknown address, so
  nothing here depends on the request; it is noindex and has no canonical.
*/
import Base from '@/layouts/Base.astro';
import Frame from '@/components/Frame.astro';
import { profile } from '@/data/content';

const host = profile.links.site.replace(/^https?:\/\//, '');
const ways = [
  { href: '/', label: 'Home' },
  { href: '/research/', label: 'Research' },
  { href: '/cv/', label: 'CV' },
];
---

<Base title="Page not found" description="This address has no page on hyeongjunlee.me." noindex>
  <section class="lost wrap">
    <Frame as="div" tl="404" tr="No page" bl={host} br="No signal" padded plate class="lost__frame">
      <div class="lost__body">
        <h1 class="lost__line">No page at this address.</h1>
        <ul class="lost__ways">
          {
            ways.map((w) => (
              <li>
                <a href={w.href}>{w.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </Frame>
  </section>
</Base>

<style>
  .lost {
    padding-block: var(--space-6) 0;
    display: grid;
    place-items: center;
  }
  .lost :global(.lost__frame) {
    width: min(100%, 48rem);
    aspect-ratio: 16 / 9;
    display: grid;
  }
  .lost :global(.lost__frame .frame__body) {
    display: grid;
    place-items: center;
    text-align: center;
  }
  .lost__body {
    display: grid;
    gap: var(--space-3);
    justify-items: center;
  }
  .lost__line {
    font-family: var(--font-display);
    font-variation-settings: 'wdth' 92;
    font-weight: 600;
    font-size: clamp(1.75rem, 1.2rem + 2.4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 16ch;
  }
  .lost__ways {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 var(--space-3);
  }
  .lost__ways a {
    display: inline-block;
    font-family: var(--font-ui);
    font-weight: 500;
    font-size: var(--size-ui);
    color: var(--ink-2);
    text-decoration-color: var(--line);
    padding-block: 0.5rem;
  }
  .lost__ways a:hover {
    color: var(--ink);
    text-decoration-color: var(--signal);
  }
  @media (max-width: 480px) {
    .lost :global(.lost__frame) {
      aspect-ratio: 3 / 4;
    }
  }
</style>
